ASPNETCORE_ENVIRONMENT= Production
ALTINN_ENVIRONMENT = PROD
GeneralSettings__Hostname = altinn.no
Environment=prod

# TODO: this should not be required - check servicedefault
Altinn__AppConfiguration__Label = prod-access-management

# TODO: move to appconfiguration
PostgreSQLSettings__AdminConnectionString = Host=authorization-postgres.altinn.no;Port=5432;Username=platform_authorization_admin;Password={0};Database=authorizationdb;SslMode=Require;Trust Server Certificate=true;Pooling=true;
PostgreSQLSettings__ConnectionString = Host=authorization-postgres.altinn.no;Port=5432;Username=platform_authorization;Password={0};Database=authorizationdb;SslMode=Require;Trust Server Certificate=true;Pooling=true;

OidcProviders__altinn__Issuer = https://platform.altinn.no/authentication/api/v1/openid/
OidcProviders__altinn__WellKnownConfigEndpoint = https://platform.altinn.no/authentication/api/v1/openid/.well-known/openid-configuration

OidcProviders__maskinporten__Issuer = https://maskinporten.no/
OidcProviders__maskinporten__WellKnownConfigEndpoint = https://maskinporten.no/.well-known/oauth-authorization-server

# TODO: use service discovery
PlatformSettings__ApiAuthenticationEndpoint = http://altinn-authentication.default.svc.cluster.local/authentication/api/v1/
PlatformSettings__ApiAuthorizationEndpoint = http://altinn-authorization.default.svc.cluster.local/authorization/api/v1/
PlatformSettings__ApiProfileEndpoint = http://altinn-profile.default.svc.cluster.local/profile/api/v1/
PlatformSettings__ApiRegisterEndpoint = http://altinn-register.default.svc.cluster.local/register/api/v1/
PlatformSettings__ApiResourceRegistryEndpoint = http://altinn-resource-registry.default.svc.cluster.local/resourceregistry/api/
PlatformSettings__AltinnPlatformBaseUrl = https://platform.altinn.cloud/

# TODO: really get rid of
SblBridgeSettings__BaseApiUrl = https://ai-pr-vip-sblbridge.ai.basefarm.net/sblbridge/
