ASPNETCORE_ENVIRONMENT=Staging
ALTINN_ENVIRONMENT=AT23
GeneralSettings__Hostname=at23.altinn.cloud
Environment=at23

# TODO: this should not be required - check servicedefault
Altinn__AppConfiguration__Label= at23-access-management

# TODO: move to appconfiguration
PostgreSQLSettings__AdminConnectionString= Host=at23-authorization-postgres.altinn.cloud;Port=5432;Username=platform_authorization_admin;Password={0};Database=authorizationdb;SslMode=Require;Trust Server Certificate=true;Pooling=true;Maximum Pool Size=2;Include Error Detail=true;
PostgreSQLSettings__ConnectionString= Host=at23-authorization-postgres.altinn.cloud;Port=5432;Username=platform_authorization;Password={0};Database=authorizationdb;SslMode=Require;Trust Server Certificate=true;Pooling=true;Maximum Pool Size=8;Include Error Detail=true;

OidcProviders__altinn__Issuer= https://platform.at23.altinn.cloud/authentication/api/v1/openid/
OidcProviders__altinn__WellKnownConfigEndpoint= https://platform.at23.altinn.cloud/authentication/api/v1/openid/.well-known/openid-configuration

OidcProviders__maskinporten-test__Issuer= https://test.maskinporten.no/
OidcProviders__maskinporten-test__WellKnownConfigEndpoint= https://test.maskinporten.no/.well-known/oauth-authorization-server

# TODO: use service discovery
PlatformSettings__ApiAuthenticationEndpoint= http://altinn-authentication.default.svc.cluster.local/authentication/api/v1/
PlatformSettings__ApiAuthorizationEndpoint= http://altinn-authorization.default.svc.cluster.local/authorization/api/v1/
PlatformSettings__ApiProfileEndpoint= http://altinn-profile.default.svc.cluster.local/profile/api/v1/
PlatformSettings__ApiRegisterEndpoint= http://altinn-register.default.svc.cluster.local/register/api/v1/
PlatformSettings__ApiResourceRegistryEndpoint= http://altinn-resource-registry.default.svc.cluster.local/resourceregistry/api/
PlatformSettings__AltinnPlatformBaseUrl= https://platform.at23.altinn.cloud/

# TODO: really get rid of
SblBridgeSettings__BaseApiUrl= https://at23.altinn.cloud/sblbridge/
