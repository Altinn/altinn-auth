ASPNETCORE_ENVIRONMENT = Production
ALTINN_ENVIRONMENT = TT02
GeneralSettings__Hostname = tt02.altinn.no
Environment=tt02

# TODO: this should not be required - check servicedefault
Altinn__AppConfiguration__Label = tt02-access-management

# TODO: move to appconfiguration
PostgreSQLSettings__AdminConnectionString = Host=tt02-authorization-postgres.altinn.no;Port=5432;Username=platform_authorization_admin;Password={0};Database=authorizationdb;SslMode=Require;Trust Server Certificate=true;Pooling=true;Maximum Pool Size=4;Include Error Detail=true;
PostgreSQLSettings__ConnectionString = Host=tt02-authorization-postgres.altinn.no;Port=5432;Username=platform_authorization;Password={0};Database=authorizationdb;SslMode=Require;Trust Server Certificate=true;Pooling=true;Maximum Pool Size=31;Include Error Detail=true;

OidcProviders__altinn__Issuer = https://platform.tt02.altinn.no/authentication/api/v1/openid/
OidcProviders__altinn__WellKnownConfigEndpoint = https://platform.tt02.altinn.no/authentication/api/v1/openid/.well-known/openid-configuration

OidcProviders__maskinporten-test__Issuer = https://test.maskinporten.no/
OidcProviders__maskinporten-test__WellKnownConfigEndpoint = https://test.maskinporten.no/.well-known/oauth-authorization-server

# TODO: use service discovery
PlatformSettings__ApiAuthenticationEndpoint = http://altinn-authentication.default.svc.cluster.local/authentication/api/v1/
PlatformSettings__ApiAuthorizationEndpoint = http://altinn-authorization.default.svc.cluster.local/authorization/api/v1/
PlatformSettings__ApiProfileEndpoint = http://altinn-profile.default.svc.cluster.local/profile/api/v1/
PlatformSettings__ApiRegisterEndpoint = http://altinn-register.default.svc.cluster.local/register/api/v1/
PlatformSettings__ApiResourceRegistryEndpoint = http://altinn-resource-registry.default.svc.cluster.local/resourceregistry/api/
PlatformSettings__AltinnPlatformBaseUrl = https://platform.tt02.altinn.no/

# TODO: really get rid of
SblBridgeSettings__BaseApiUrl = https://ai-tt02-vip-sblbridge.ai.basefarm.net/sblbridge/
