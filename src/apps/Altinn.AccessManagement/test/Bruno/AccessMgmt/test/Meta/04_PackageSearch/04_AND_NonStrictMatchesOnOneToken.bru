meta {
  name: 04_AND_NonStrictMatchesOnOneToken
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/meta/info/accesspackages/search?term={{term}}&strict=false
  body: none
  auth: none
}

params:query {
  term: {{term}}
  strict: false
}

docs {
  AND the same term with strict false still matches on the token that is
  real, since strict is off by default and only one token needs to score.
}

script:pre-request {
  bru.setVar("term", "underhold qqqqzzzz");
}

tests {
  const td = require("./testdata/meta/" + bru.getEnvVar("tokenEnv") + ".js");

  test("AND a non strict search with one matching token returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the package with the matching token is returned", function() {
    const data = res.getBody();
    const match = data.find(x => x.object.id === td.packages.kunstOgUnderholdning.id);
    expect(match, "expected the Kunst og underholdning package in the non strict result").to.exist;
  });
}
