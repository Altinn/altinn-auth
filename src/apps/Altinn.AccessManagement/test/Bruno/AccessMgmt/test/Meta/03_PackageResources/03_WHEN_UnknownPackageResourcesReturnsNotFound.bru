meta {
  name: 03_WHEN_UnknownPackageResourcesReturnsNotFound
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/meta/info/accesspackages/package/:id/resources
  body: none
  auth: none
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

docs {
  WHEN the resources of an unknown package are requested, THEN the response
  is 404 because the package itself cannot be found.
}

tests {
  test("WHEN the package id is unknown, the request returns 404", function() {
    expect(res.status).to.equal(404);
  });

  test("THEN the response carries a problem body", function() {
    const body = res.getBody();
    expect(body).to.have.property("status", 404);
  });
}
