meta {
  name: 02_AND_RoleIsLookedUpById
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/meta/info/roles/:id
  body: none
  auth: none
}

params:path {
  id: {{roleId}}
}

docs {
  AND a role is looked up by id, THEN the response is an array holding that
  one role, not a single object. This is the actual shape of the endpoint
  and is asserted as such.
}

script:pre-request {
  const td = require("./testdata/meta/" + bru.getEnvVar("tokenEnv") + ".js");

  bru.setVar("roleId", td.roles.deltakerDeltAnsvar.id);
}

tests {
  const td = require("./testdata/meta/" + bru.getEnvVar("tokenEnv") + ".js");

  test("AND the role by id request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the response is an array containing the role", function() {
    const data = res.getBody();
    expect(data).to.be.an("array").with.lengthOf(1);
    expect(data[0]).to.have.property("id", td.roles.deltakerDeltAnsvar.id);
    expect(data[0]).to.have.property("code", td.roles.deltakerDeltAnsvar.code);
    expect(data[0]).to.have.property("name", td.roles.deltakerDeltAnsvar.name);
  });
}
