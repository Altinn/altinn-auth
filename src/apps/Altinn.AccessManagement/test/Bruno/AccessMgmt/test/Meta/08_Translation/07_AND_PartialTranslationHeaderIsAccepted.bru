meta {
  name: 07_AND_PartialTranslationHeaderIsAccepted
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/meta/info/accesspackages/package/:id
  body: none
  auth: none
}

params:path {
  id: {{packageId}}
}

headers {
  Accept-Language: nn
  X-Accept-Partial-Translation: false
}

docs {
  AND the X-Accept-Partial-Translation header is accepted alongside
  Accept-Language, and the request still returns the translated package.
  The package used in this scenario has a complete Nynorsk translation, so
  disallowing partial translation makes no observable difference here; a
  package with a partial translation would be needed to see the header
  change the outcome.
}

script:pre-request {
  const td = require("./testdata/meta/" + bru.getEnvVar("tokenEnv") + ".js");

  bru.setVar("packageId", td.packages.kunstOgUnderholdning.id);
}

tests {
  const td = require("./testdata/meta/" + bru.getEnvVar("tokenEnv") + ".js");

  test("AND the request with X-Accept-Partial-Translation returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the fully translated name is still returned", function() {
    const body = res.getBody();
    expect(body.name).to.equal(td.packages.kunstOgUnderholdning.nnName);
  });
}
