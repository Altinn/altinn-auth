meta {
  name: 02_AND_SamePackagesAreFetchedById
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/meta/info/roles/:id/packages?variant={{variant}}
  body: none
  auth: none
}

params:query {
  variant: {{variant}}
}

params:path {
  id: {{roleId}}
}

docs {
  AND the same packages are reachable through the {id}/packages route,
  addressing the role by id instead of by code and variant query.
}

script:pre-request {
  const td = require("./testdata/meta/" + bru.getEnvVar("tokenEnv") + ".js");

  bru.setVar("roleId", td.roles.revisor.id);
  bru.setVar("variant", td.roles.revisor.variant);
}

tests {
  const td = require("./testdata/meta/" + bru.getEnvVar("tokenEnv") + ".js");

  test("AND the role id packages route returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the same two packages are returned", function() {
    const data = res.getBody();
    expect(data.map(p => p.name)).to.have.members(td.roles.revisor.packageNames);
  });
}
