meta {
  name: 05_AND_NoPartyAppearsTwice
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/resourceowner/authorizedparties?includeRoles=true&includeAccessPackages=true
  body: json
  auth: inherit
}

params:query {
  includeRoles: true
  includeAccessPackages: true
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "type": "urn:altinn:person:identifier-no",
    "value": "{{subjectPersonId}}"
  }
}

docs {
  AND no party appears twice anywhere in the response, counting main units and their
  subunits together.
}

script:pre-request {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const sharedtestdata = require(`./testdata/sharedtestdata.js`);
  const { loginAsServiceOwner } = require("./test/AuthorizedParties/ServiceOwnerAuthorizedParties/helpers.js");

  bru.setVar("subjectPersonId", testdata.REGN_ULASTELIG_RETTFERDIG_TIGER.dagligleder.pid);

  await loginAsServiceOwner(sharedtestdata.serviceOwners.digdir);
}

tests {
  const { duplicatePartyUuids } = require("./test/AuthorizedParties/ServiceOwnerAuthorizedParties/helpers.js");

  test("AND the request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("AND no party uuid appears more than once in the response", function() {
    const duplicates = duplicatePartyUuids(res.getBody());
    expect(duplicates, `duplicate party uuids found: ${duplicates.join(", ")}`).to.be.empty;
  });
}
