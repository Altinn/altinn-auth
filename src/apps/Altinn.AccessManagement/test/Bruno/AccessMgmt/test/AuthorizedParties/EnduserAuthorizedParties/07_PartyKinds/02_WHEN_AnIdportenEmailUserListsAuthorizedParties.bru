meta {
  name: 02_WHEN_AnIdportenEmailUserListsAuthorizedParties
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/authorizedparties?includeRoles=true
  body: none
  auth: inherit
}

params:query {
  includeRoles: true
}

docs {
  WHEN an ID-porten user registered by email address lists authorized parties, the only
  party returned is the user's own, carrying the email identifier as its identity.
}

script:pre-request {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { loginAsEmailUser } = require("./test/AuthorizedParties/EnduserAuthorizedParties/helpers.js");

  await loginAsEmailUser(testdata.idportenEmailUser);
}

tests {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { lower } = require("./test/AuthorizedParties/EnduserAuthorizedParties/helpers.js");

  const user = testdata.idportenEmailUser;

  test("WHEN an ID-porten email user lists authorized parties, the request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the user's own party is the only party returned", function() {
    expect(res.getBody().data).to.have.lengthOf(1);
    expect(res.getBody().data[0].partyUuid.toLowerCase()).to.equal(user.partyUuid.toLowerCase());
  });

  test("THEN the party carries the email identifier and no national identity number", function() {
    const party = res.getBody().data[0];
    expect(party.type).to.equal("SelfIdentified");
    expect(party.emailId).to.equal(user.emailId);
    expect(party.personId).to.be.null;
    expect(lower(party.authorizedRoles)).to.include("seln");
  });
}
