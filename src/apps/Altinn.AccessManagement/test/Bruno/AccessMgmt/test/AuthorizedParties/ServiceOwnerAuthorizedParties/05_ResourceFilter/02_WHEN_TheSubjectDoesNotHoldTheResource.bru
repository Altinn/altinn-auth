meta {
  name: 02_WHEN_TheSubjectDoesNotHoldTheResource
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/resourceowner/authorizedparties?includeResources=true&anyOfResourceIds={{resourceId}}
  body: json
  auth: inherit
}

params:query {
  includeResources: true
  anyOfResourceIds: {{resourceId}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "type": "urn:altinn:person:identifier-no",
    "value": "{{subjectPersonId}}"
  }
}

docs {
  WHEN the subject is an employee who holds packages on the firm but not the filtered resource,
  the client that carries that resource for another person is not returned, and no returned
  party carries the filtered resource.
}

script:pre-request {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const sharedtestdata = require(`./testdata/sharedtestdata.js`);
  const { loginAsServiceOwner } = require("./test/AuthorizedParties/ServiceOwnerAuthorizedParties/helpers.js");

  bru.setVar("subjectPersonId", testdata.REGN_ULASTELIG_RETTFERDIG_TIGER.employee_rightholderWithPackages.pid);
  bru.setVar("resourceId", testdata.REGN_ULASTELIG_RETTFERDIG_TIGER.client_rightholderOrg2.resourceIdDelegatedToPerson);

  await loginAsServiceOwner(sharedtestdata.serviceOwners.digdir);
}

tests {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { findParty, flatten } = require("./test/AuthorizedParties/ServiceOwnerAuthorizedParties/helpers.js");

  const firm = testdata.REGN_ULASTELIG_RETTFERDIG_TIGER;
  const resourceId = firm.client_rightholderOrg2.resourceIdDelegatedToPerson;

  test("WHEN the subject does not hold the filtered resource, the request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the party that carries the resource for another person is not returned", function() {
    expect(findParty(res.getBody(), firm.client_rightholderOrg2.partyUuid), "the rightholder client is not reachable for this subject").to.be.undefined;
  });

  test("THEN no returned party carries the filtered resource", function() {
    for (const party of flatten(res.getBody())) {
      expect(party.authorizedResources, `${party.partyUuid} unexpectedly carries the filtered resource`).to.not.include(resourceId);
    }
  });
}
