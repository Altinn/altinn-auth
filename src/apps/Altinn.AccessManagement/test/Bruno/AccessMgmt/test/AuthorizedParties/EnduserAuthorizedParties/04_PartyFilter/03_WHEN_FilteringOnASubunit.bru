meta {
  name: 03_WHEN_FilteringOnASubunit
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/authorizedparties?includeAccessPackages=true&includeResources=true&partyFilter={{subUnit}}
  body: none
  auth: inherit
}

params:query {
  includeAccessPackages: true
  includeResources: true
  partyFilter: {{subUnit}}
}

docs {
  WHEN the list is filtered on a subunit, the subunit is returned nested under its main
  unit, since a subunit is never returned at the top level. The subunit carries the
  access delegated to it as well as the access it inherits from the main unit, while the
  main unit itself is only a hierarchy carrier with no access information of its own.
}

script:pre-request {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { loginAs } = require("./test/AuthorizedParties/EnduserAuthorizedParties/helpers.js");

  bru.setVar("subUnit", testdata.REGN_ULASTELIG_RETTFERDIG_TIGER.client_rightholderOrg2.subunit.partyUuid);

  await loginAs(testdata.REGN_ULASTELIG_RETTFERDIG_TIGER.dagligleder);
}

tests {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { flatten } = require("./test/AuthorizedParties/EnduserAuthorizedParties/helpers.js");

  const client = testdata.REGN_ULASTELIG_RETTFERDIG_TIGER.client_rightholderOrg2;

  test("WHEN filtering on a subunit, the request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the subunit is returned nested under its main unit and nothing else is", function() {
    const parties = flatten(res.getBody().data);
    expect(parties.map(party => party.partyUuid.toLowerCase())).to.have.members([
      client.partyUuid.toLowerCase(),
      client.subunit.partyUuid.toLowerCase(),
    ]);
    expect(res.getBody().data).to.have.lengthOf(1);
    expect(res.getBody().data[0].partyUuid.toLowerCase()).to.equal(client.partyUuid.toLowerCase());
  });

  test("THEN the subunit carries both its own and the main unit's access", function() {
    const subunit = res.getBody().data[0].subunits[0];
    expect(subunit.organizationNumber).to.equal(client.subunit.orgno);
    expect(subunit.authorizedAccessPackages).to.include.members([
      client.subunit.packageDelegatedToPerson,
      client.subunit.packageDelegatedToKeyRoleUnit,
      client.packageDelegatedToPerson,
    ]);
    expect(subunit.authorizedResources).to.include.members([
      client.subunit.resourceIdDelegatedToPerson,
      client.subunit.resourceIdDelegatedToKeyRoleUnit,
      client.resourceIdDelegatedToPerson,
    ]);
  });

  test("THEN the main unit is only a hierarchy carrier with no access info of its own", function() {
    const mainUnit = res.getBody().data[0];
    expect(mainUnit.onlyHierarchyElementWithNoAccess, "the main unit did not match the filter").to.be.true;
    expect(mainUnit.authorizedRoles).to.be.empty;
    expect(mainUnit.authorizedAccessPackages).to.be.empty;
    expect(mainUnit.authorizedResources).to.be.empty;
    expect(mainUnit.authorizedInstances).to.be.empty;
  });
}
