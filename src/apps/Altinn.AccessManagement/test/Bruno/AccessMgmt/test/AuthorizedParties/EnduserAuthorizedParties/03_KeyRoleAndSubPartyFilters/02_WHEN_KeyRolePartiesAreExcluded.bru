meta {
  name: 02_WHEN_KeyRolePartiesAreExcluded
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/authorizedparties?includePartiesViaKeyRoles=false&includeAccessPackages=true
  body: none
  auth: inherit
}

params:query {
  includePartiesViaKeyRoles: false
  includeAccessPackages: true
}

docs {
  WHEN key role parties are excluded, the parties the caller only reaches because the
  accounting firm has access to them drop out. The firm itself stays, and so do the
  parties that have delegated something to the person directly.
}

script:pre-request {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { loginAs } = require("./test/AuthorizedParties/EnduserAuthorizedParties/helpers.js");

  await loginAs(testdata.REGN_ULASTELIG_RETTFERDIG_TIGER.dagligleder);
}

tests {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { findParty } = require("./test/AuthorizedParties/EnduserAuthorizedParties/helpers.js");

  const firm = testdata.REGN_ULASTELIG_RETTFERDIG_TIGER;

  test("WHEN key role parties are excluded, the request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the clients the caller only reaches through the firm are gone", function() {
    expect(findParty(res.getBody().data, firm.client_USENSUELL_UVIRKSOM_TIGER.partyUuid), "the accountant client should not be reachable without key role parties").to.be.undefined;
    expect(findParty(res.getBody().data, firm.client_WITHOUT_CLIENTDELEGATION.partyUuid), "the client without a client delegation should not be reachable without key role parties").to.be.undefined;
  });

  test("THEN the firm the caller is daily leader for is still returned", function() {
    const party = findParty(res.getBody().data, firm.partyUuid);
    expect(party, "expected the accounting firm itself").to.not.be.undefined;
    expect(party.authorizedAccessPackages).to.not.be.empty;
  });

  test("THEN a party that delegated directly to the person is still returned", function() {
    const party = findParty(res.getBody().data, firm.client_rightholderOrg2.partyUuid);
    expect(party, "expected the party that delegated directly to the person").to.not.be.undefined;
    expect(party.authorizedAccessPackages).to.include(firm.client_rightholderOrg2.packageDelegatedToPerson);
  });
}
