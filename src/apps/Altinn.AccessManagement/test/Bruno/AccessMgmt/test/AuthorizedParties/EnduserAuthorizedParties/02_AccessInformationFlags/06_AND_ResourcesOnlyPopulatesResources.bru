meta {
  name: 06_AND_ResourcesOnlyPopulatesResources
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/authorizedparties?includeResources=true
  body: none
  auth: inherit
}

params:query {
  includeResources: true
}

docs {
  AND asking for resources alone populates the resource collection and leaves roles,
  access packages and instances empty.
}

script:pre-request {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { loginAs } = require("./test/AuthorizedParties/EnduserAuthorizedParties/helpers.js");

  await loginAs(testdata.REGN_ULASTELIG_RETTFERDIG_TIGER.dagligleder);
}

tests {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { flatten, findParty } = require("./test/AuthorizedParties/EnduserAuthorizedParties/helpers.js");

  const rightholderClient = testdata.REGN_ULASTELIG_RETTFERDIG_TIGER.client_rightholderOrg2;

  test("AND the request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("AND the single resources delegated to the rightholder client are returned", function() {
    const party = findParty(res.getBody().data, rightholderClient.partyUuid);
    expect(party.authorizedResources).to.include.members([
      rightholderClient.resourceIdDelegatedToPerson,
      rightholderClient.resourceIdDelegatedToKeyRoleUnit,
    ]);
  });

  test("AND roles, access packages and instances stay empty", function() {
    for (const party of flatten(res.getBody().data)) {
      expect(party.authorizedRoles, `roles returned for ${party.partyUuid}`).to.be.empty;
      expect(party.authorizedAccessPackages, `access packages returned for ${party.partyUuid}`).to.be.empty;
      expect(party.authorizedInstances, `instances returned for ${party.partyUuid}`).to.be.empty;
    }
  });
}
