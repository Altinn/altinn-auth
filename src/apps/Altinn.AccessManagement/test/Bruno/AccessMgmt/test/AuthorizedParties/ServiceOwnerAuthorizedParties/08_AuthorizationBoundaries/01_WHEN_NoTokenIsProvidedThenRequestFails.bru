meta {
  name: 01_WHEN_NoTokenIsProvidedThenRequestFails
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/resourceowner/authorizedparties
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "type": "urn:altinn:person:identifier-no",
    "value": "{{subjectPersonId}}"
  }
}

docs {
  WHEN the request carries no token, the endpoint rejects it with 401 before any lookup.
}

script:pre-request {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  bru.setVar("subjectPersonId", testdata.REGN_ULASTELIG_RETTFERDIG_TIGER.dagligleder.pid);
  bru.setVar("bearerToken", "");
}

tests {
  test("WHEN no token is provided, the request returns 401", function() {
    expect(res.status).to.equal(401);
  });
}
