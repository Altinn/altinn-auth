meta {
  name: 01_WHEN_ASelfIdentifiedUserListsAuthorizedParties
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/authorizedparties?includeRoles=true
  body: none
  auth: inherit
}

params:query {
  includeRoles: true
}

docs {
  WHEN a self identified user lists authorized parties, the only party returned is the
  user's own, typed as self identified and holding the self identified user roles. A self
  identified user has no national identity number and authenticates at level 1.
}

script:pre-request {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { loginAsSelfIdentifiedUser } = require("./test/AuthorizedParties/EnduserAuthorizedParties/helpers.js");

  await loginAsSelfIdentifiedUser(testdata.a2BrunoSIUser);
}

tests {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { lower } = require("./test/AuthorizedParties/EnduserAuthorizedParties/helpers.js");

  const user = testdata.a2BrunoSIUser;

  test("WHEN a self identified user lists authorized parties, the request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the user's own party is the only party returned", function() {
    expect(res.getBody().data).to.have.lengthOf(1);
    expect(res.getBody().data[0].partyUuid.toLowerCase()).to.equal(user.partyUuid.toLowerCase());
  });

  test("THEN the party is typed as self identified with the self identified roles", function() {
    const party = res.getBody().data[0];
    expect(party.type).to.equal("SelfIdentified");
    expect(party.personId, "a self identified user has no national identity number").to.be.null;
    expect(party.organizationNumber).to.be.null;
    expect(lower(party.authorizedRoles)).to.include("seln");
  });
}
