meta {
  name: 06_AND_SubPartiesAreIncluded
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/authorizedparties?includeSubParties=true
  body: none
  auth: inherit
}

params:query {
  includeSubParties: true
}

docs {
  AND with subunits included, the client organisations carry their subunits nested under
  them.
}

script:pre-request {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { loginAs } = require("./test/AuthorizedParties/EnduserAuthorizedParties/helpers.js");

  await loginAs(testdata.REGN_ULASTELIG_RETTFERDIG_TIGER.dagligleder);
}

tests {
  const testdata = require(`./test/AuthorizedParties/testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { findParty, partyUuids } = require("./test/AuthorizedParties/EnduserAuthorizedParties/helpers.js");

  const firm = testdata.REGN_ULASTELIG_RETTFERDIG_TIGER;

  test("AND the request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("AND the client's subunit is nested under the client", function() {
    const client = findParty(res.getBody().data, firm.client_USENSUELL_UVIRKSOM_TIGER.partyUuid);
    expect(client, "expected the client organisation").to.not.be.undefined;
    expect(client.subunits.map(subunit => subunit.partyUuid.toLowerCase()))
      .to.include(firm.client_USENSUELL_UVIRKSOM_TIGER.subunit.partyUuid.toLowerCase());
  });

  bru.setVar("subPartiesTruePartyUuids", JSON.stringify(partyUuids(res.getBody().data).sort()));
}
