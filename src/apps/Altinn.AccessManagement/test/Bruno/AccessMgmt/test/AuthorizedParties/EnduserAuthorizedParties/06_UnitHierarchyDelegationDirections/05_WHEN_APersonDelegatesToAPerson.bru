meta {
  name: 05_WHEN_APersonDelegatesToAPerson
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/authorizedparties?includeAccessPackages=true&includeResources=true&includeInstances=true
  body: none
  auth: inherit
}

params:query {
  includeAccessPackages: true
  includeResources: true
  includeInstances: true
}

docs {
  WHEN a person has delegated to another person, the recipient sees the delegating person
  with the delegated packages, resources and app instance.
}

script:pre-request {
  const testdata = require(`./testdata/auth-parties-testdata/${bru.getEnvVar("tokenEnv")}.js`);
  const { loginAs } = require("./test/AuthorizedParties/EnduserAuthorizedParties/helpers.js");

  await loginAs(testdata.authParties_personB);
}

tests {
  const testdata = require(`./testdata/auth-parties-testdata/${bru.getEnvVar("tokenEnv")}.js`);

  const delegator = testdata.authParties_personA;

  test("WHEN a person delegates to a person, the request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the recipient sees the delegating person with the delegated access", function() {
    const party = res.getBody().data.find(item => item.partyUuid.toLowerCase() === delegator.partyuuid.toLowerCase());
    expect(party, "expected the delegating person in the party list").to.not.be.undefined;
    expect(party.type).to.equal("Person");
    expect(party.personId).to.equal(delegator.pid);
    expect(party.authorizedAccessPackages).to.not.be.empty;
  });

  test("THEN the app instance the person delegated is on the person party", function() {
    const party = res.getBody().data.find(item => item.partyUuid.toLowerCase() === delegator.partyuuid.toLowerCase());
    const instance = party.authorizedInstances.find(item => item.instanceRef === testdata.instancer.personA_instansid);
    expect(instance, "expected the delegated app instance on the person party").to.not.be.undefined;
    expect(instance.resourceId).to.be.a("string").that.is.not.empty;
    expect(instance.instanceRef).to.contain(instance.instanceId);
  });
}
