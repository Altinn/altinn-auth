meta {
  name: 07_AND_RequestIsListedForUser
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/bff/consentrequests/list/:partyUuid
  body: none
  auth: inherit
}

params:path {
  partyUuid: {{partyUuid}}
}

docs {
  AND the request is listed for the person.

  GET /accessmanagement/api/v1/bff/consentrequests/list/:partyUuid

  Lists every consent request offered by a party (the from party), in every status and
  regardless of portalViewMode. Not paginated.

  - partyUuid (path): the party the consent is asked from.
  - Token: personal token with scope altinn:portal/enduser. The user must have read
    access to access management for the party; otherwise 401.

  Typical response: 200 with an array of requests. Parties are urn:altinn:party:uuid, the
  status field is named consentRequestStatus, and resources carry the resource version.

  The list also holds requests from earlier runs, so the step looks the new one up by id.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/Consent/helpers.js");
  const td = testdata();

  bru.setVar("partyUuid", td.consentingPerson.partyUuid);

  await loginAs(td.consentingPerson);
}

tests {
  const { testdata } = require("./test/Consent/helpers.js");
  const td = testdata();

  test("WHEN the person lists requests, the request returns 200", function() {
    expect(res.status).to.equal(200);
    expect(res.getBody()).to.be.an("array").that.is.not.empty;
  });

  test("THEN every listed request is offered by the person", function() {
    res.getBody().forEach(r => {
      expect(r.from).to.equal(`urn:altinn:party:uuid:${td.consentingPerson.partyUuid}`);
    });
  });

  test("THEN the new request is listed as Created", function() {
    const item = res.getBody().find(r => r.id === bru.getVar("consentRequestId"));
    expect(item, "expected the new request in the list").to.not.be.undefined;
    expect(item.to).to.equal(`urn:altinn:party:uuid:${td.enterprise.partyUuid}`);
    expect(item.consentRequestStatus).to.equal("Created");
    expect(item.consentRights[0].resource[0].value).to.equal(td.consentResource.id);
    expect(item.portalViewMode).to.equal("Show");
  });
}
