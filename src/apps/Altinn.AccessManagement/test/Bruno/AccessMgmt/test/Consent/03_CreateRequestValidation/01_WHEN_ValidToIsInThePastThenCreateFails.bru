meta {
  name: 01_WHEN_ValidToIsInThePastThenCreateFails
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/enterprise/consentrequests
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{consentRequestId}}",
    "from": "{{consentFrom}}",
    "to": "{{consentTo}}",
    "validTo": "2020-01-01T00:00:00Z",
    "consentRights": [
      {
        "action": ["{{consentAction}}"],
        "resource": [
          {
            "type": "urn:altinn:resource",
            "value": "{{consentResource}}"
          }
        ],
        "metadata": {
          "inntektsaar": "{{consentMetadataValue}}"
        }
      }
    ],
    "redirectUrl": "https://altinn.no",
    "portalViewMode": "show"
  }
}

docs {
  WHEN validTo is in the past, the create fails with a validation error.

  POST /accessmanagement/api/v1/enterprise/consentrequests

  validTo must lie in the future. Expects 400 with error code STD-00000 and validation
  error AM.VLD-00022 whose path points at ValidTo.
}

script:pre-request {
  const { loginAsEnterprise, prepareConsentRequest, scopes, testdata } = require("./test/Consent/helpers.js");
  const td = testdata();

  prepareConsentRequest("consentRequestId");

  await loginAsEnterprise(td.enterprise, scopes.consentRequestsWrite);
}

tests {
  test("WHEN validTo is in the past, the request returns 400", function() {
    expect(res.status).to.equal(400);
  });

  test("THEN validation error AM.VLD-00022 points at ValidTo", function() {
    const body = res.getBody();
    expect(body.status).to.equal(400);
    expect(body.code).to.equal("STD-00000");
    expect(body.validationErrors).to.have.lengthOf(1);
    expect(body.validationErrors[0].code).to.equal("AM.VLD-00022");
    expect(body.validationErrors[0].paths).to.deep.equal(["ValidTo"]);
  });
}
