meta {
  name: 04_WHEN_OtherPersonReadsRequestInPortalThenForbidden
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/bff/consentrequests/:requestId
  body: none
  auth: inherit
}

params:path {
  requestId: {{boundaryRequestId}}
}

docs {
  WHEN another person reads the request in the portal, the request is forbidden.

  GET /accessmanagement/api/v1/bff/consentrequests/:requestId

  Only a user who may answer the request can read it through the BFF. A person with no
  rights for the from party gets 403 with problem code AM-00000.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/Consent/helpers.js");
  const td = testdata();

  await loginAs(td.otherPerson);
}

tests {
  test("WHEN another person reads the request, the request returns 403", function() {
    expect(res.status).to.equal(403);
  });

  test("THEN the problem is AM-00000, not authorized for consent", function() {
    const body = res.getBody();
    expect(body.status).to.equal(403);
    expect(body.code).to.equal("AM-00000");
  });
}
