meta {
  name: 01_GIVEN_EnterpriseCreatesConsentRequest
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/enterprise/consentrequests
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{rejectRequestId}}",
    "from": "{{consentFrom}}",
    "to": "{{consentTo}}",
    "validTo": "{{consentValidTo}}",
    "consentRights": [
      {
        "action": ["{{consentAction}}"],
        "resource": [
          {
            "type": "urn:altinn:resource",
            "value": "{{consentResource}}"
          }
        ],
        "metadata": {
          "inntektsaar": "{{consentMetadataValue}}"
        }
      }
    ],
    "redirectUrl": "https://altinn.no",
    "portalViewMode": "show"
  }
}

docs {
  GIVEN the enterprise has created a consent request for the person.

  POST /accessmanagement/api/v1/enterprise/consentrequests

  A fresh request with a new id, so the scenario never depends on earlier runs. See
  scenario 01 step 02 for the full description of the endpoint and body. This request
  leaves out the optional requestMessage.
}

script:pre-request {
  const { loginAsEnterprise, prepareConsentRequest, scopes, testdata } = require("./test/Consent/helpers.js");
  const td = testdata();

  prepareConsentRequest("rejectRequestId");

  await loginAsEnterprise(td.enterprise, scopes.consentRequestsWrite);
}

tests {
  test("GIVEN the consent request is created, the request returns 201", function() {
    expect(res.status).to.equal(201);
  });

  test("THEN the request has status Created and no request message", function() {
    const body = res.getBody();
    expect(body.id).to.equal(bru.getVar("rejectRequestId"));
    expect(body.status).to.equal("Created");
    expect(body.requestMessage).to.be.null;
  });
}
