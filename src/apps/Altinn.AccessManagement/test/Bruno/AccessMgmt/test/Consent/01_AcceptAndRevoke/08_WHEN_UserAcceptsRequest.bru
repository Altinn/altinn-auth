meta {
  name: 08_WHEN_UserAcceptsRequest
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/bff/consentrequests/:requestId/accept
  body: json
  auth: inherit
}

params:path {
  requestId: {{consentRequestId}}
}

body:json {
  {
    "language": "nb"
  }
}

docs {
  WHEN the person accepts the request.

  POST /accessmanagement/api/v1/bff/consentrequests/:requestId/accept

  Accepts a consent request in status Created. The request then becomes a consent with the
  same id, which the enterprise can use until validTo.

  - requestId (path): the consent request id.
  - Body: the consent context, language (required), the language the consent text was
    shown in (nb, nn or en). A body without language is rejected with 400 by model
    validation.
  - Token: personal token with scope altinn:portal/enduser. The user must have write
    access to access management for the from party and be able to delegate every
    requested right (or be the requiredDelegator when one is set).

  Typical response: 200 with the request in BFF shape, consented set and an Accepted event
  performed by the user. 400 (AM-00002) when the request is not in status Created, 403
  (AM-00000) when the user may not answer.

  Known issue: accepting a request that is already accepted returns 500 instead of the
  request, so this scenario accepts exactly once.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/Consent/helpers.js");
  const td = testdata();

  await loginAs(td.consentingPerson);
}

tests {
  const { testdata } = require("./test/Consent/helpers.js");
  const td = testdata();

  test("WHEN the person accepts the request, the request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the request is consented", function() {
    const body = res.getBody();
    expect(body.id).to.equal(bru.getVar("consentRequestId"));
    expect(body.consented).to.be.a("string");
    expect(new Date(body.consented).getTime()).to.be.closeTo(Date.now(), 10 * 60 * 1000);
    expect(body.from).to.equal(`urn:altinn:party:uuid:${td.consentingPerson.partyUuid}`);
    expect(body.to).to.equal(`urn:altinn:party:uuid:${td.enterprise.partyUuid}`);
  });

  test("THEN an Accepted event is recorded, performed by the person", function() {
    const events = res.getBody().consentRequestEvents;
    expect(events.map(e => e.eventType)).to.deep.equal(["Created", "Accepted"]);
    expect(events[1].performedBy).to.equal(`urn:altinn:party:uuid:${td.consentingPerson.partyUuid}`);
  });
}
