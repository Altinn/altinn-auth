meta {
  name: 13_WHEN_OtherPersonRevokesConsentThenForbidden
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/bff/consents/:consentId/revoke
  body: none
  auth: inherit
}

params:path {
  consentId: {{consentRequestId}}
}

docs {
  WHEN another person revokes the consent, the request is forbidden.

  POST /accessmanagement/api/v1/bff/consents/:consentId/revoke

  See step 15 for the endpoint. The caller needs write access to access management for
  the from party. Without it the endpoint answers 403 with no body, and the consent stays
  accepted (step 14).
}

script:pre-request {
  const { loginAs, testdata } = require("./test/Consent/helpers.js");
  const td = testdata();

  await loginAs(td.otherPerson);
}

tests {
  test("WHEN another person revokes the consent, the request returns 403", function() {
    expect(res.status).to.equal(403);
  });
}
