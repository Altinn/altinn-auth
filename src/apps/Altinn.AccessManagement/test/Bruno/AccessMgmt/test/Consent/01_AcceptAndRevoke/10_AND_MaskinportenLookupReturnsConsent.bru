meta {
  name: 10_AND_MaskinportenLookupReturnsConsent
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/maskinporten/consent/lookup
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{consentRequestId}}",
    "from": "{{consentFrom}}",
    "to": "{{consentTo}}"
  }
}

docs {
  AND the Maskinporten lookup returns the consent.

  POST /accessmanagement/api/v1/maskinporten/consent/lookup

  Used by Maskinporten when the enterprise asks for a consent token: checks that the
  consent exists, is accepted, not revoked and not expired, and belongs to the given
  parties, and returns what goes into the token.

  - Body: id (the consent id), from (urn:altinn:person:identifier-no:... or
    urn:altinn:organization:identifier-no:...), to (urn:altinn:organization:identifier-no:...
    of the enterprise, or of the handledBy party).
  - Token: scope altinn:maskinporten/consent.read. In production only Maskinporten holds
    it; here an enterprise token with that scope stands in.

  Typical response: 200 with id, from, to, handledBy, consented, validTo and consentRights.
  400 with AM-00014 (not accepted), AM-00011 (revoked), AM-00013 (expired) or AM-00012
  (from does not match), 404 (AM-00001) for an unknown id.
}

script:pre-request {
  const { loginAsEnterprise, scopes, testdata } = require("./test/Consent/helpers.js");
  const td = testdata();

  await loginAsEnterprise(td.enterprise, scopes.maskinportenConsentRead);
}

tests {
  const { testdata } = require("./test/Consent/helpers.js");
  const td = testdata();

  test("WHEN the accepted consent is looked up, the request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the consent is returned with external identifiers and the consented rights", function() {
    const body = res.getBody();
    expect(body.id).to.equal(bru.getVar("consentRequestId"));
    expect(body.from).to.equal(`urn:altinn:person:identifier-no:${td.consentingPerson.pid}`);
    expect(body.to).to.equal(`urn:altinn:organization:identifier-no:${td.enterprise.orgno}`);
    expect(body.handledBy).to.be.null;
    expect(body.consented).to.be.a("string");
    expect(new Date(body.validTo).getTime()).to.be.closeTo(new Date(bru.getVar("consentValidTo")).getTime(), 1000);
    expect(body.consentRights).to.have.lengthOf(1);
    expect(body.consentRights[0].action).to.deep.equal([td.consentResource.action]);
    expect(body.consentRights[0].resource[0].value).to.equal(td.consentResource.id);
    expect(body.consentRights[0].metadata).to.deep.equal({ [td.consentResource.metadataKey]: td.consentResource.metadataValue });
  });
}
