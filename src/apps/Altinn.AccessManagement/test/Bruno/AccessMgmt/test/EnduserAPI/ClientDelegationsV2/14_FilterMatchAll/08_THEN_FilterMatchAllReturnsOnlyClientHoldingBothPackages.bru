meta {
  name: 08_THEN_FilterMatchAllReturnsOnlyClientHoldingBothPackages
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/clientdelegations/clients?party={{party}}&packages={{rolePackage}}&packages={{grantedPackage}}&match=all
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  packages: {{rolePackage}}
  packages: {{grantedPackage}}
  match: all
}

docs {
  THEN the same filter with match=all returns only clients holding both packages.
  The CCR client holds the lonn package through the regnskapsforer role and the
  skattegrunnlag package through the grant on its rightholder relation. The
  rightholder client is returned only when the test data marks it as a CCR client
  of the facilitator too (client_B.alsoCcrClientOfFacilitator); in AT22 and TT02 it is.
  None of the clients step 07 found holding only one of the packages is returned.
}

script:pre-request {
  const td = require(`./testdata/klient-delegation/${bru.getEnvVar("tokenEnv")}.js`);
  const { loginAs } = require("./test/EnduserAPI/ClientDelegationsV2/helpers.js");

  bru.setVar("party", td.REGN_Organisasjon.partyUuid);
  bru.setVar("rolePackage", td.clientDelegationV2.packages.regnskapsforerLonn);
  bru.setVar("grantedPackage", td.clientDelegationV2.packages.skattegrunnlag);

  await loginAs(td.REGN_Organisasjon.dagligleder);
}

tests {
  const td = require(`./testdata/klient-delegation/${bru.getEnvVar("tokenEnv")}.js`);

  test("THEN the all mode client list request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the CCR client is returned, and the rightholder client when it is also a CCR client", function() {
    const data = res.getBody().data;
    const clientA = td.REGN_Organisasjon.REGN_Org_Clients.client_A.partyUuid.toLowerCase();
    const fixtureB = td.REGN_Organisasjon.REGN_Org_Clients.client_B;
    const holdsBoth = fixtureB.alsoCcrClientOfFacilitator === true;
    expect(data.some(item => item.client.id.toLowerCase() === clientA), "expected the CCR client in the all mode list").to.be.true;
    expect(data.some(item => item.client.id.toLowerCase() === fixtureB.partyUuid.toLowerCase()), holdsBoth
      ? "the rightholder client is also a CCR client and holds both packages"
      : "the rightholder client holds only one of the packages").to.equal(holdsBoth);
  });

  test("AND no client that holds only one of the packages is returned", function() {
    const singlePackageClientIds = JSON.parse(bru.getVar("singlePackageClientIds") || "[]");
    expect(singlePackageClientIds, "step 07 records the clients holding only one package").to.not.be.empty;
    const returned = res.getBody().data
      .filter(item => singlePackageClientIds.includes(item.client.id.toLowerCase()))
      .map(item => item.client.name);
    expect(returned, "match=all returned clients that hold only one of the packages").to.be.empty;
  });

  test("AND every returned client holds both filter packages", function() {
    const rolePackage = td.clientDelegationV2.packages.regnskapsforerLonn;
    const grantedPackage = td.clientDelegationV2.packages.skattegrunnlag;
    res.getBody().data.forEach(item => {
      const urns = item.access.flatMap(a => a.packages.map(p => p.urn));
      expect(urns, `expected ${item.client.name} to hold ${rolePackage}`).to.include(rolePackage);
      expect(urns, `expected ${item.client.name} to hold ${grantedPackage}`).to.include(grantedPackage);
    });
  });
}
