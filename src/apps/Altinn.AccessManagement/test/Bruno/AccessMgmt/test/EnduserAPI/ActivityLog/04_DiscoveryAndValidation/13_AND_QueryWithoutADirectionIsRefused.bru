meta {
  name: 13_AND_QueryWithoutADirectionIsRefused
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party={{party}}
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
}

docs {
  AND a query without `direction` is refused with 403, not 400. The scope policy picks
  the scope it requires from the direction parameter, so with no direction no scope
  matches and authorization fails before the controller validates the query. The same
  holds for `direction=via`, which is reserved for client administration.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata().connections;

  bru.setVar("party", td.delegator.partyUuid);

  await loginAs(td.delegator);
}

tests {
  test("AND the query without a direction is refused with 403", function() {
    expect(res.status).to.equal(403);
  });
}
