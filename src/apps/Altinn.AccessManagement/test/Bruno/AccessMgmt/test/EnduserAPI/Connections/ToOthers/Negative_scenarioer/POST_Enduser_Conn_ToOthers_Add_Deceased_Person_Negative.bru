meta {
  name: POST_Enduser_Conn_ToOthers_Add_Deceased_Person_Negative
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/connections?party={{party}}&from={{party}}
  body: json
  auth: inherit
}

params:query {
  party: {{party}}
  from: {{party}}
}

headers {
  Accept: application/json
}

body:json {
  {
    "personIdentifier": "{{toPerson}}",
    "lastName": "{{toPersonLastName}}"
  }
}

script:pre-request {
  const sharedtestdata = require(`./testdata/sharedtestdata.js`);
  const testdata = require(`./testdata/klient-delegation/${bru.getEnvVar("tokenEnv")}.js`);

  bru.setVar("party", testdata.REGN_Organisasjon.partyUuid);
  bru.setVar("toPerson", testdata.deceasedPerson.personidentity);
  bru.setVar("toPersonLastName", testdata.deceasedPerson.etternavn);

  var getTokenParameters = {
    auth_userId: testdata.REGN_Organisasjon.dagligleder.userId,
    auth_partyId: testdata.REGN_Organisasjon.dagligleder.partyId,
    auth_partyUuid: testdata.REGN_Organisasjon.dagligleder.partyUuid,
    auth_ssn: testdata.REGN_Organisasjon.dagligleder.pid,
    auth_tokenType: sharedtestdata.authTokenType.personal,
    auth_scopes: sharedtestdata.auth_scopes.portalEnduser
  }

  const testTokenGenerator = require(`./TestToolsTokenGenerator.js`);
  const token = await testTokenGenerator.getToken(getTokenParameters);
  bru.setVar("bearerToken", token);
}

tests {
  test("Adding a deceased person as rightholder returns 400", function() {
    expect(res.status).to.equal(400);
  });

  test("The error body reports validation error AM.VLD-00034 for a deceased person", function() {
    const body = res.getBody();
    expect(body.code).to.equal("STD-00000");
    const err = body.validationErrors.find(e => e.code === "AM.VLD-00034");
    expect(err, "expected validation error AM.VLD-00034").to.not.be.undefined;
    expect(JSON.stringify(err)).to.include("deceased");
  });
}

docs {
  Dagligleder in REGN_Organisasjon tries to add a person who is registered as
  deceased as rightholder, by person number and last name.

  Expects 400 with validation error AM.VLD-00034 on the person input. Mirrors the
  AddRightholder_AsManagingDirectorForDeadPersonViaPersonInput_ReturnsBadRequest
  integration test.
}
