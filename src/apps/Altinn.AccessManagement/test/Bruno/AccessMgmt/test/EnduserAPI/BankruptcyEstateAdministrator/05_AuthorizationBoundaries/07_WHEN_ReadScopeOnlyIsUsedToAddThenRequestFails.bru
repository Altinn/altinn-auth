meta {
  name: 07_WHEN_ReadScopeOnlyIsUsedToAddThenRequestFails
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/bankruptcyestate/administrators?party={{party}}
  body: json
  auth: inherit
}

params:query {
  party: {{party}}
}

body:json {
  {
    "personIdentifier": "{{personIdentifier}}",
    "lastName": "{{lastName}}"
  }
}

docs {
  WHEN the bostyrer adds an administrator with a token carrying only the dedicated read
  scope, the request fails with 403.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipOutsideSupportedEnvironments()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("party", td.BOSTYRER.partyUuid);
  bru.setVar("personIdentifier", td.user_LUN_ANALYSE_GÅSTOL.pid);
  bru.setVar("lastName", td.user_LUN_ANALYSE_GÅSTOL.lastname);

  await helpers.loginAs(td.BOSTYRER, helpers.scopes.bankruptcyEstateRead);
}

tests {
  test("WHEN only the read scope is used to add, the request returns 403", function() {
    expect(res.status).to.equal(403);
  });
}
