meta {
  name: 04_WHEN_UserIsNotAUuidThenRequestFails
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/bankruptcyestate/administrators?party={{party}}&user=not-a-uuid
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  user: not-a-uuid
}

docs {
  WHEN the user query parameter is not a uuid. Model binding rejects the request. Expects
  400; only the status is asserted.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipOutsideSupportedEnvironments()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("party", td.BOSTYRER.partyUuid);

  await helpers.loginAs(td.BOSTYRER);
}

tests {
  test("WHEN the user parameter is not a uuid, the request returns 400", function() {
    expect(res.status).to.equal(400);
  });
}
