meta {
  name: 06_WHEN_WriteScopeOnlyIsUsedToReadThenRequestFails
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/bankruptcyestate/administrators?party={{party}}
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
}

docs {
  WHEN the bostyrer lists administrators with a token carrying only the dedicated write
  scope. The write scope does not imply read, so the request fails with 403.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipOutsideSupportedEnvironments()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("party", td.BOSTYRER.partyUuid);

  await helpers.loginAs(td.BOSTYRER, helpers.scopes.bankruptcyEstateWrite);
}

tests {
  test("WHEN only the write scope is used to read, the request returns 403", function() {
    expect(res.status).to.equal(403);
  });
}
