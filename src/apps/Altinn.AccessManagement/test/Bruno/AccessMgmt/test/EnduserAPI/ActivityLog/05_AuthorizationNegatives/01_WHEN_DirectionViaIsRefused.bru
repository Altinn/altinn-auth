meta {
  name: 01_WHEN_DirectionViaIsRefused
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party={{party}}&direction=via
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: via
}

docs {
  WHEN the delegator asks with `direction=via`, it is refused. Via is part of the enum
  but reserved for client administration, and no scope policy covers it: 403.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata();

  bru.setVar("party", td.connections.delegator.partyUuid);

  await loginAs(td.connections.delegator);
}

tests {
  test("WHEN the request is refused with 403", function() {
    expect(res.status).to.equal(403);
  });
}
