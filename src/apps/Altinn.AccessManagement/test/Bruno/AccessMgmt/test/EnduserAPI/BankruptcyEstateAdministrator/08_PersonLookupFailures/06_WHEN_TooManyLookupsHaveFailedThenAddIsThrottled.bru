meta {
  name: 04_WHEN_TooManyLookupsHaveFailedThenAddIsThrottled
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/bankruptcyestate/administrators?party={{party}}
  body: json
  auth: inherit
}

params:query {
  party: {{party}}
}

body:json {
  {
    "personIdentifier": "{{personIdentifier}}",
    "lastName": "{{lastName}}"
  }
}

docs {
  WHEN the bostyrer, after the failed lookups, adds the assistant with the correct SSN and
  last name. A pod that has reached MaximumFailedAttempts refuses the lookup outright with 429
  AM-00026. A pod without recorded failures accepts it with 200, so the add is repeated until
  a 429 arrives, at most eight requests in all. A 200 adds the assistant, which the CLEANUP
  step removes again.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipUnlessPersonLookupNegativesEnabled()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("party", td.BOSTYRER.partyUuid);
  bru.setVar("personIdentifier", td.user_LUN_ANALYSE_GÅSTOL.pid);
  bru.setVar("lastName", td.user_LUN_ANALYSE_GÅSTOL.lastname);

  await helpers.loginAs(td.BOSTYRER);
}

script:post-response {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  let responses = [{ status: res.status, code: res.getBody() && res.getBody().code }];
  if (res.status !== 429) {
    responses = responses.concat(await helpers.addAdministratorUntil(
      bru.getVar("party"),
      { personIdentifier: bru.getVar("personIdentifier"), lastName: bru.getVar("lastName") },
      429,
      7));
  }
  bru.setVar("validAddResponses", JSON.stringify(responses));
}

tests {
  test("WHEN too many lookups have failed, a valid add is refused with 429", function() {
    const responses = JSON.parse(bru.getVar("validAddResponses"));
    console.log("valid add responses:", responses.map(r => r.status).join(" "));
    expect(responses.map(r => r.status), "expected a 429 within eight valid adds").to.include(429);
  });

  test("THEN the problem body reports AM-00026", function() {
    const responses = JSON.parse(bru.getVar("validAddResponses"));
    expect(responses.find(r => r.status === 429).code).to.equal("AM-00026");
  });

  test("AND every other response is an accepted add from a pod without failures", function() {
    const responses = JSON.parse(bru.getVar("validAddResponses"));
    for (const r of responses.filter(r => r.status !== 429)) {
      expect(r.status).to.equal(200);
    }
  });
}
