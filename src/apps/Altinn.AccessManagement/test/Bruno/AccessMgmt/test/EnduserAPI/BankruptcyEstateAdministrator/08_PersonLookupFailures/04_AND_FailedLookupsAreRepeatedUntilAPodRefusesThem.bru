meta {
  name: 04_AND_FailedLookupsAreRepeatedUntilAPodRefusesThem
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/bankruptcyestate/administrators?party={{party}}
  body: json
  auth: inherit
}

params:query {
  party: {{party}}
}

body:json {
  {
    "personIdentifier": "{{personIdentifier}}",
    "lastName": "{{lastName}}"
  }
}

docs {
  AND the bostyrer repeats the unknown-person lookup until a pod answers 429, at most eight
  requests in all. The failed-lookup counter is held in each pod's memory and the client
  cannot choose the pod, so steps 02 and 03 may have landed on different pods. A 429 here
  proves at least one pod has reached MaximumFailedAttempts for the bostyrer.

  Each response is 400 AM.VLD-00034 (counted as another failure on that pod) until one is 429.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipUnlessPersonLookupNegativesEnabled()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("party", td.BOSTYRER.partyUuid);
  bru.setVar("personIdentifier", "bruno-ukjent-bruker-finnes-ikke");
  bru.setVar("lastName", "Ukjent");

  await helpers.loginAs(td.BOSTYRER);
}

script:post-response {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  let responses = [{ status: res.status, code: res.getBody() && res.getBody().code }];
  if (res.status !== 429) {
    responses = responses.concat(await helpers.addAdministratorUntil(
      bru.getVar("party"),
      { personIdentifier: bru.getVar("personIdentifier"), lastName: bru.getVar("lastName") },
      429,
      7));
  }
  bru.setVar("failedLookupResponses", JSON.stringify(responses));
}

tests {
  test("AND some pod refuses the lookups with 429 AM-00026", function() {
    const responses = JSON.parse(bru.getVar("failedLookupResponses"));
    console.log("failed lookup responses:", responses.map(r => r.status).join(" "));
    const refused = responses.find(r => r.status === 429);
    expect(refused, "expected a 429 within eight failed lookups").to.not.be.undefined;
    expect(refused.code).to.equal("AM-00026");
  });

  test("AND every response before the 429 is a rejected lookup", function() {
    const responses = JSON.parse(bru.getVar("failedLookupResponses"));
    for (const r of responses.filter(r => r.status !== 429)) {
      expect(r.status).to.equal(400);
    }
  });
}
