meta {
  name: 07_CLEANUP_AssistantIsRevoked
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/bankruptcyestate/administrators?party={{party}}&user={{user}}
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  user: {{user}}
}

docs {
  CLEANUP: removes the assistant in case one of the valid adds in step 06 reached a pod
  without failures and succeeded. Revoking needs no person lookup, so it is not throttled.
  Returns 204 either way.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipUnlessPersonLookupNegativesEnabled()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("party", td.BOSTYRER.partyUuid);
  bru.setVar("user", td.user_LUN_ANALYSE_GÅSTOL.partyUuid);

  await helpers.loginAs(td.BOSTYRER);
}

tests {
  test("CLEANUP: the assistant is revoked, the request returns 204", function() {
    expect(res.status).to.equal(204);
  });
}
