meta {
  name: 06_AND_UnrelatedScopeIsRefused
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party={{party}}&direction=from
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: from
}

docs {
  AND a token with only an unrelated scope (`altinn:instances:read`) is refused,
  although the user may act for the party: 403.
}

script:pre-request {
  const { loginAs, scopes, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata();

  bru.setVar("party", td.connections.delegator.partyUuid);

  await loginAs(td.connections.delegator, scopes.read);
}

tests {
  test("AND the request is refused with 403", function() {
    expect(res.status).to.equal(403);
  });
}
