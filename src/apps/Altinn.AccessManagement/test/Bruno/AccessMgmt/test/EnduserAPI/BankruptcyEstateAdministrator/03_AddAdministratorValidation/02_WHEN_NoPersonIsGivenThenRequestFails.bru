meta {
  name: 02_WHEN_NoPersonIsGivenThenRequestFails
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/bankruptcyestate/administrators?party={{party}}
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
}

docs {
  WHEN the bostyrer adds an administrator without a body.

  Expects 400 with a required-field error pointing at the person input. The error comes from
  the standard required-field descriptor, so no specific AM code is asserted.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipOutsideSupportedEnvironments()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("party", td.BOSTYRER.partyUuid);

  await helpers.loginAs(td.BOSTYRER);
}

tests {
  test("WHEN no person is given, the request returns 400", function() {
    expect(res.status).to.equal(400);
  });

  test("THEN the error body reports a validation error on /PersonIdentifier", function() {
    const body = res.getBody();
    expect(body.code).to.equal("STD-00000");
    expect(body.validationErrors).to.be.an("array").that.is.not.empty;
    expect(body.validationErrors.flatMap(e => e.paths)).to.include("/PersonIdentifier");
  });
}
