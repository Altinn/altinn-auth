meta {
  name: 08_AND_SupplierCannotReadTheConsumersLog
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/maskinporten/activitylog?party={{party}}&direction=from
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: from
}

docs {
  AND the supplier's innehaver cannot read the consumer's log, since it cannot act for
  the consumer: 403.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata().maskinporten;

  bru.setVar("party", td.consumer.partyUuid);

  await loginAs(td.supplier.innehaver);
}

tests {
  test("AND the supplier is refused with 403", function() {
    expect(res.status).to.equal(403);
  });
}
