meta {
  name: 07_CLEANUP_AssistantIsRevoked
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/bankruptcyestate/administrators?party={{party}}&user={{user}}
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  user: {{user}}
}

docs {
  CLEANUP: the bostyrer revokes the assistant. Expects 204, and then lists the administrators
  to assert the assistant is gone, since revoke also returns 204 when nothing was removed.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipOutsideSupportedEnvironments()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("party", td.BOSTYRER.partyUuid);
  bru.setVar("user", td.user_LUN_ANALYSE_GÅSTOL.partyUuid);

  await helpers.loginAs(td.BOSTYRER);
}

script:post-response {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (res.status === 204) {
    bru.setVar("administratorsAfterCleanup", JSON.stringify(await helpers.listAdministrators(bru.getVar("party"))));
  }
}

tests {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  const td = helpers.testdata();

  test("WHEN the assistant is revoked, the request returns 204", function() {
    expect(res.status).to.equal(204);
  });

  test("THEN the assistant is no longer listed as an administrator", function() {
    const body = JSON.parse(bru.getVar("administratorsAfterCleanup"));
    expect(helpers.findAdministrator(body, td.user_LUN_ANALYSE_GÅSTOL.partyUuid)).to.be.undefined;
  });
}
