meta {
  name: 03_AND_EmptyPartyIsRefused
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party=00000000-0000-0000-0000-000000000000&direction=from
  body: none
  auth: inherit
}

params:query {
  party: 00000000-0000-0000-0000-000000000000
  direction: from
}

docs {
  AND the empty uuid as party is refused by the party authorization check: 403.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata();

  await loginAs(td.connections.delegator);
}

tests {
  test("AND the request is refused with 403", function() {
    expect(res.status).to.equal(403);
  });
}
