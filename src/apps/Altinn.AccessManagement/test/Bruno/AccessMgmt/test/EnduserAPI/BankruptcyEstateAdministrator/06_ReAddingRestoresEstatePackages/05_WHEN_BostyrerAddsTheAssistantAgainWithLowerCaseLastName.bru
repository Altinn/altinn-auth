meta {
  name: 05_WHEN_BostyrerAddsTheAssistantAgainWithLowerCaseLastName
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/bankruptcyestate/administrators?party={{party}}
  body: json
  auth: inherit
}

params:query {
  party: {{party}}
}

body:json {
  {
    "personIdentifier": "{{personIdentifier}}",
    "lastName": "{{lastName}}"
  }
}

docs {
  WHEN the bostyrer adds the assistant again, giving the last name in lower case. The last
  name match ignores case, so the lookup succeeds. Expects 200.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipOutsideSupportedEnvironments()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("party", td.BOSTYRER.partyUuid);
  bru.setVar("personIdentifier", td.user_LUN_ANALYSE_GÅSTOL.pid);
  bru.setVar("lastName", td.user_LUN_ANALYSE_GÅSTOL.lastname.toLowerCase());

  await helpers.loginAs(td.BOSTYRER);
}

tests {
  test("WHEN the bostyrer adds the assistant again with a lower case last name, the request returns 200", function() {
    expect(res.status).to.equal(200);
  });
}
