meta {
  name: 08_AND_ServiceOwnerCannotReadAnEndusersRequestLog
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/request/activitylog?party={{party}}&direction=from
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: from
}

docs {
  AND the service owner, which creates requests on behalf of a requester, cannot read
  the requester's request log with its service owner token: 403.
}

script:pre-request {
  const { loginAsServiceOwner, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata();

  bru.setVar("party", td.request.requester.partyUuid);

  await loginAsServiceOwner();
}

tests {
  test("AND the request is refused with 403", function() {
    expect(res.status).to.equal(403);
  });
}
