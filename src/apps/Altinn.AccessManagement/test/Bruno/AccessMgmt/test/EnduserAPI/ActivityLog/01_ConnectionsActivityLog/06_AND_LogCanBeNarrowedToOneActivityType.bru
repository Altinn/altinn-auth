meta {
  name: 06_AND_LogCanBeNarrowedToOneActivityType
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party={{party}}&direction=from&typeId={{typeId}}&parentId={{al_assignmentId}}
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: from
  typeId: {{typeId}}
  parentId: {{al_assignmentId}}
}

docs {
  AND the log can be narrowed to one activity type: `typeId` takes catalog ids from
  `GET .../activitylog/types`, and `parentId` restricts the entries to the children of
  this run's assignment. Together they leave exactly the access package entry.
}

script:pre-request {
  const { activityTypes, loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata().connections;

  bru.setVar("party", td.delegator.partyUuid);
  bru.setVar("typeId", activityTypes.packageGranted);

  await loginAs(td.delegator);
}

tests {
  const { activityTypes, sameId } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const body = res.getBody();

  test("AND the narrowed log returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("AND only the access package entry of this run is left", function() {
    expect(body.data).to.have.lengthOf(1);
    expect(body.data[0].activityTypeId).to.equal(activityTypes.packageGranted);
    expect(sameId(body.data[0].itemId, bru.getVar("al_assignmentPackageId"))).to.equal(true);
    expect(body.links.next).to.equal(null);
  });
}
