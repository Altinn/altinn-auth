meta {
  name: 04_AND_OutsiderCannotListTheDelegatorsUsers
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/connections/users?party={{party}}
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
}

docs {
  AND an outsider cannot list the delegator's available users.

  The outsider has no right to act for the delegator, so the authorization check on the
  party fails and the request returns 403 with no body.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/Connections/AvailableUsersAndRights/helpers.js");
  const td = testdata();

  bru.setVar("party", td.delegator.partyUuid);

  await loginAs(td.outsider);
}

tests {
  test("AND the outsider is refused with 403", function() {
    expect(res.status).to.equal(403);
  });
}
