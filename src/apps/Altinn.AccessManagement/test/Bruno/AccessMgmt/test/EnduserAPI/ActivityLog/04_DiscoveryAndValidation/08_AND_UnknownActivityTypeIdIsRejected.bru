meta {
  name: 08_AND_UnknownActivityTypeIdIsRejected
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party={{party}}&direction=from&typeId=11111111-1111-1111-1111-111111111111
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: from
  typeId: 11111111-1111-1111-1111-111111111111
}

docs {
  AND an activity type id that is not in the catalog is rejected with 400.

  The response is a validation problem with the message under `errors.TypeId`.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata().connections;

  bru.setVar("party", td.delegator.partyUuid);

  await loginAs(td.delegator);
}

tests {
  test("AND the query is rejected with 400", function() {
    expect(res.status).to.equal(400);
  });

  test("AND the problem names TypeId", function() {
    const body = res.getBody();
    expect(body.status).to.equal(400);
    expect(body.errors).to.have.property("TypeId");
    expect(body.errors["TypeId"][0]).to.include("Unknown activity type id");
  });
}
