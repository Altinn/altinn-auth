meta {
  name: 04_AND_PartyThatIsNotAUuidIsRefused
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party=not-a-uuid&direction=from
  body: none
  auth: inherit
}

params:query {
  party: not-a-uuid
  direction: from
}

docs {
  AND a party that is not a uuid is refused: 403.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata();

  await loginAs(td.connections.delegator);
}

tests {
  test("AND the request is refused with 403", function() {
    expect(res.status).to.equal(403);
  });
}
