meta {
  name: 02_AND_RemovingAnAltinn3RoleIsRejected
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/connections/roles?party={{party}}&from={{party}}&to={{to}}&rolecode=rettighetshaver
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  from: {{party}}
  to: {{to}}
  rolecode: rettighetshaver
}

docs {
  AND removing an Altinn 3 role is rejected.

  The rightholder role (`rettighetshaver`) is removed through
  `DELETE /accessmanagement/api/v1/enduser/connections`, not through the roles endpoint.
  Expects 400 AM-00040 whether or not the role is assigned.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/Connections/AvailableUsersAndRights/helpers.js");
  const td = testdata();

  bru.setVar("party", td.delegator.partyUuid);
  bru.setVar("to", td.receiver.partyUuid);

  await loginAs(td.delegator);
}

tests {
  test("AND the removal is rejected with 400", function() {
    expect(res.status).to.equal(400);
  });

  test("AND the problem body says the role cannot be revoked", function() {
    const body = res.getBody();
    expect(body.status).to.equal(400);
    expect(body.code).to.equal("AM-00040");
    expect(body.detail).to.equal("Given the rules for revocation this role could not be revoked");
  });
}
