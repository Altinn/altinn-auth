meta {
  name: 09_AND_NextPageContinuesWithoutOverlap
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party={{party}}&direction=from&to={{to}}&pageSize=1&pageNo=1
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: from
  to: {{to}}
  pageSize: 1
  pageNo: 1
}

docs {
  AND the next page continues without overlap: page 1 (`pageNo` is zero-based) with the
  same filters holds a different, older (or equally old) entry than the first page.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata().connections;

  bru.setVar("party", td.delegator.partyUuid);
  bru.setVar("to", td.receiver.partyUuid);

  await loginAs(td.delegator);
}

tests {
  const body = res.getBody();

  test("AND the next page returns 200 with one entry", function() {
    expect(res.status).to.equal(200);
    expect(body.data).to.have.lengthOf(1);
  });

  test("AND the entry differs from the first page and is not newer", function() {
    expect(body.data[0].id).to.not.equal(bru.getVar("al_firstPageEntryId"));
    expect(Date.parse(body.data[0].when)).to.be.at.most(Date.parse(bru.getVar("al_firstPageEntryWhen")));
  });
}
