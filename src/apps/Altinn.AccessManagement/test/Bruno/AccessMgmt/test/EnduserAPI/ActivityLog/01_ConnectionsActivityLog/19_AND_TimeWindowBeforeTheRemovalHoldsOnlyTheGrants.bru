meta {
  name: 19_AND_TimeWindowBeforeTheRemovalHoldsOnlyTheGrants
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party={{party}}&direction=from&to={{to}}&after={{after}}&before={{before}}&pageSize=50
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: from
  to: {{to}}
  after: {{after}}
  before: {{before}}
  pageSize: 50
}

docs {
  AND a time window from the grant up to the removal holds this run's grants but not its
  removals. `after` is inclusive and `before` exclusive, so the window
  `[grant, removal)` keeps the Created entries and leaves the Deleted ones out.

  The bounds are sent as `toISOString()`, which cuts the API's timestamps to
  milliseconds. A cut-off bound is never later than the real one, so the grant stays
  inside `after` and the removal stays outside `before`; it also avoids an unencoded `+`
  in the URL.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata().connections;

  bru.setVar("party", td.delegator.partyUuid);
  bru.setVar("to", td.receiver.partyUuid);
  bru.setVar("after", new Date(bru.getVar("al_assignmentCreatedAt")).toISOString());
  bru.setVar("before", new Date(bru.getVar("al_removedAt")).toISOString());

  await loginAs(td.delegator);
}

tests {
  const { entriesFor } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const body = res.getBody();
  const after = Date.parse(bru.getVar("after"));
  const before = Date.parse(bru.getVar("before"));

  test("AND the time window returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("AND every entry lies inside the window", function() {
    body.data.forEach(e => {
      const when = Date.parse(e.when);
      expect(when >= after, `${e.when} is before after`).to.equal(true);
      expect(when < before, `${e.when} is not before before`).to.equal(true);
    });
  });

  test("AND the window holds the grants of this run", function() {
    const assignment = entriesFor(body, bru.getVar("al_assignmentId"));
    const pkg = entriesFor(body, bru.getVar("al_assignmentPackageId"));
    expect(assignment).to.have.lengthOf(1);
    expect(pkg).to.have.lengthOf(1);
    expect(assignment[0].trigger).to.equal("Created");
    expect(pkg[0].trigger).to.equal("Created");
  });
}
