meta {
  name: 05_WHEN_PersonIsNotAnAdministratorThenRevokeSucceeds
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/bankruptcyestate/administrators?party={{party}}&user={{user}}
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  user: {{user}}
}

docs {
  WHEN the bostyrer revokes a person who is not their administrator. Nothing changes and the
  revoke is idempotent, so it returns 204.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipOutsideSupportedEnvironments()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("party", td.BOSTYRER.partyUuid);
  bru.setVar("user", td.creditor_VILJESTERK_GRANDIS.partyUuid);

  await helpers.loginAs(td.BOSTYRER);
}

tests {
  test("WHEN the person is not an administrator, the request returns 204", function() {
    expect(res.status).to.equal(204);
  });
}
