meta {
  name: 11_AND_UnknownFilterFieldIsRejected
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog/filter/Bogus?party={{party}}&direction=from
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: from
}

docs {
  AND a filter value lookup on a field that does not exist is rejected with 400.

  The response is a validation problem with the message under `errors.field`.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata().connections;

  bru.setVar("party", td.delegator.partyUuid);

  await loginAs(td.delegator);
}

tests {
  test("AND the query is rejected with 400", function() {
    expect(res.status).to.equal(400);
  });

  test("AND the problem names field", function() {
    const body = res.getBody();
    expect(body.status).to.equal(400);
    expect(body.errors).to.have.property("field");
    expect(body.errors["field"][0]).to.include("is not valid");
  });
}
