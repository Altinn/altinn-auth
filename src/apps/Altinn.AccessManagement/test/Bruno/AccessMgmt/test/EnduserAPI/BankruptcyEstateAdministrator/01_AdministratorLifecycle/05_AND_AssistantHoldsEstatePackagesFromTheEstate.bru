meta {
  name: 05_AND_AssistantHoldsEstatePackagesFromTheEstate
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/connections/accesspackages?party={{assistant}}&from={{estateId}}&to={{assistant}}
  body: none
  auth: inherit
}

params:query {
  party: {{assistant}}
  from: {{estateId}}
  to: {{assistant}}
}

docs {
  AND the assistant, looking at their own access, holds the three estate packages from the
  estate stored in the previous step. The connection is a rightholder connection from the
  estate to the assistant.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipOutsideSupportedEnvironments()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("assistant", td.user_LUN_ANALYSE_GÅSTOL.partyUuid);

  await helpers.loginAs(td.user_LUN_ANALYSE_GÅSTOL);
}

tests {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");

  test("AND the assistant's packages from the estate can be listed, the request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("AND the assistant holds the three estate packages from the estate", function() {
    const urns = res.getBody().data.map(item => item.package.urn);
    expect(urns).to.include.members(helpers.estatePackageUrns);
  });
}
