meta {
  name: 02_AND_UnknownDirectionIsRefused
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party={{party}}&direction=sideways
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: sideways
}

docs {
  AND a direction that is not from, to or via is refused: 403.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata();

  bru.setVar("party", td.connections.delegator.partyUuid);

  await loginAs(td.connections.delegator);
}

tests {
  test("AND the request is refused with 403", function() {
    expect(res.status).to.equal(403);
  });
}
