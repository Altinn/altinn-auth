meta {
  name: 13_WHEN_PartyIsUnknownThenRequestFails
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/bankruptcyestate/administrators?party={{party}}
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
}

docs {
  WHEN the party is a uuid that does not exist, the PDP denies access and the request fails
  with 403.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipOutsideSupportedEnvironments()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("party", helpers.unknownPartyUuid);

  await helpers.loginAs(td.BOSTYRER);
}

tests {
  test("WHEN the party is unknown, the request returns 403", function() {
    expect(res.status).to.equal(403);
  });
}
