meta {
  name: 11_AND_ReceiverCannotReadTheDelegatorsLog
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party={{party}}&direction=from
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: from
}

docs {
  AND the receiver cannot read the delegator's log either. Holding a rightholder
  connection and an access package from a party lets you use that access, not act for
  the party, so the authorization check on the party fails with 403.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata().connections;

  bru.setVar("party", td.delegator.partyUuid);

  await loginAs(td.receiver);
}

tests {
  test("AND the receiver is refused with 403", function() {
    expect(res.status).to.equal(403);
  });
}
