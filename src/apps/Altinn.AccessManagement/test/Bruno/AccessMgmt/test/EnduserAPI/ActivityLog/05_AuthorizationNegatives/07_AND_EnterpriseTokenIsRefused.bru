meta {
  name: 07_AND_EnterpriseTokenIsRefused
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party={{party}}&direction=from
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: from
}

docs {
  AND an enterprise token (ttd, even with `altinn:portal/enduser`) is refused: the
  enduser log needs a user who can act for the party. 403.
}

script:pre-request {
  const { loginAsServiceOwner, scopes, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata();

  bru.setVar("party", td.connections.delegator.partyUuid);

  await loginAsServiceOwner(scopes.portalEnduser);
}

tests {
  test("AND the request is refused with 403", function() {
    expect(res.status).to.equal(403);
  });
}
