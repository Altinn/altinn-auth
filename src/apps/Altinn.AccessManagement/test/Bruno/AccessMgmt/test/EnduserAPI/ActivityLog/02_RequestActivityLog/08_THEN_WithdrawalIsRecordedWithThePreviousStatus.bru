meta {
  name: 08_THEN_WithdrawalIsRecordedWithThePreviousStatus
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/request/activitylog?party={{party}}&direction=from&itemId={{al_requestId}}&status=Withdrawn
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: from
  itemId: {{al_requestId}}
  status: Withdrawn
}

docs {
  THEN the withdrawal is recorded: one Updated entry in status Withdrawn, newer than the
  draft, with the status it left in the details (`previousStatus`, the numeric value of
  Draft).
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata().request;

  bru.setVar("party", td.requester.partyUuid);

  await loginAs(td.requester);
}

tests {
  const { activityTypes } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const body = res.getBody();

  test("THEN the log returns 200 with one withdrawal", function() {
    expect(res.status).to.equal(200);
    expect(body.data).to.have.lengthOf(1);
  });

  test("THEN the withdrawal is an update to status Withdrawn, from Draft", function() {
    const e = body.data[0];
    expect(e.type).to.equal("Request");
    expect(e.subtype).to.equal("Package");
    expect(e.trigger).to.equal("Updated");
    expect(e.status).to.equal("Withdrawn");
    expect(e.activityTypeId).to.equal(activityTypes.packageRequestWithdrawn);
    expect(e.details.previousStatus).to.equal(1);
  });
}
