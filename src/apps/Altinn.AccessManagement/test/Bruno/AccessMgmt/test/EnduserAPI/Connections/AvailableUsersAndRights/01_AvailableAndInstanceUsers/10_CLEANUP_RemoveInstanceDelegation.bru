meta {
  name: 10_CLEANUP_RemoveInstanceDelegation
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/connections/resources/instances?party={{party}}&from={{party}}&to={{to}}&resource={{resource}}&instance={{instance}}
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  from: {{party}}
  to: {{to}}
  resource: {{resource}}
  instance: {{instance}}
}

docs {
  CLEANUP: the delegator removes the instance delegation to the receiver.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/Connections/AvailableUsersAndRights/helpers.js");
  const td = testdata();

  bru.setVar("party", td.delegator.partyUuid);
  bru.setVar("to", td.receiver.partyUuid);
  bru.setVar("resource", td.app.appId);
  bru.setVar("instance", td.app.instanceUrn);

  await loginAs(td.delegator);
}

tests {
  test("CLEANUP the instance delegation is removed with 204", function() {
    expect(res.status).to.equal(204);
  });
}
