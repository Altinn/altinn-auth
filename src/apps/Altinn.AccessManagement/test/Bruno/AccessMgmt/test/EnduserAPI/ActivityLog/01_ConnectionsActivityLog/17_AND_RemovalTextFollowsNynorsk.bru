meta {
  name: 17_AND_RemovalTextFollowsNynorsk
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party={{party}}&direction=from&to={{to}}&trigger=Deleted&pageSize=50
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: from
  to: {{to}}
  trigger: Deleted
  pageSize: 50
}

headers {
  Accept-Language: nn
}

docs {
  AND with `Accept-Language: nn` the same removal entries read in Nynorsk. Only the
  template changes with the language; the names are the snapshots stored with the entry.
}

script:pre-request {
  const { loginAs, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata().connections;

  bru.setVar("party", td.delegator.partyUuid);
  bru.setVar("to", td.receiver.partyUuid);

  await loginAs(td.delegator);
}

tests {
  const { entriesFor, expectedText } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const body = res.getBody();

  test("AND with Accept-Language nn, the log returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("AND the removals read as sentences in Nynorsk", function() {
    const assignment = entriesFor(body, bru.getVar("al_assignmentId"));
    const pkg = entriesFor(body, bru.getVar("al_assignmentPackageId"));
    expect(assignment).to.have.lengthOf(1);
    expect(pkg).to.have.lengthOf(1);
    expect(assignment[0].text).to.equal(expectedText(assignment[0], "nno"));
    expect(pkg[0].text).to.equal(expectedText(pkg[0], "nno"));
  });
}
