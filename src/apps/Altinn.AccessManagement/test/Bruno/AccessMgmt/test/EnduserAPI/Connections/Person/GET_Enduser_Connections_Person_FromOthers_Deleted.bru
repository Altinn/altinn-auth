meta {
  name: GET_Enduser_Connections_Person_FromOthers_Deleted
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/connections?party={{party}}&to={{party}}&from={{fromParty}}
  body: json
  auth: inherit
}

params:query {
  party: {{party}}
  to: {{party}}
  from: {{fromParty}}
  ~to: {{toPerson}}
}

body:json {
   {
    "personidentifier": "{{toPerson}}", // fnr or username
    "lastName": "{{toPersonLastName}}"
  }
}

script:pre-request {
  const sharedtestdata = require(`./testdata/sharedtestdata.js`);
  const testdata = require(`./testdata/person-accesspackage-delegation/${bru.getEnvVar("tokenEnv")}.js`);
  
  bru.setVar("party", testdata.vassen_riktig_tiger_as.person1.partyuuid);
  bru.setVar("fromParty", testdata.vassen_riktig_tiger_as.partyuuid);
  bru.setVar("toPerson", testdata.vassen_riktig_tiger_as.person1.pid);
  bru.setVar("toPersonLastName", testdata.vassen_riktig_tiger_as.person1.lastname);
  
  var getTokenParameters = {
    auth_userId: testdata.vassen_riktig_tiger_as.person1.userid,
    auth_partyId: testdata.vassen_riktig_tiger_as.person1.partyid,
    auth_partyUuid: testdata.vassen_riktig_tiger_as.person1.partyuuid,
    auth_ssn: testdata.vassen_riktig_tiger_as.person1.pid,
    auth_tokenType: sharedtestdata.authTokenType.personal,
    auth_scopes: sharedtestdata.auth_scopes.portalEnduser
  }
  
  
  const testTokenGenerator = require(`./TestToolsTokenGenerator.js`);
  const token = await testTokenGenerator.getToken(getTokenParameters);
  bru.setVar("bearerToken",  token);
}

tests {
  test("GET_Enduser_Connections_Person_FromOthers_Deleted", function() {
  
     expect(res.status).to.equal(200);
     const data = res.getBody();
    
     // The delete uses cascade=true, so no connection from the organization should remain.
     assert.isEmpty(data.data, "Expected no connection from the organization after the delete");
  });
}
