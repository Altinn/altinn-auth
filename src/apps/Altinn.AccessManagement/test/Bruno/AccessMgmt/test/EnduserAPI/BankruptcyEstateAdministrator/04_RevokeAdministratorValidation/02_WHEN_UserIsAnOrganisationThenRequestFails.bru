meta {
  name: 02_WHEN_UserIsAnOrganisationThenRequestFails
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/bankruptcyestate/administrators?party={{party}}&user={{user}}
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  user: {{user}}
}

docs {
  WHEN the bostyrer revokes an organisation. Only persons can be administrators. Expects 400
  with validation error AM.VLD-00008 (entity type not allowed) on QUERY/to.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipOutsideSupportedEnvironments()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("party", td.BOSTYRER.partyUuid);
  bru.setVar("user", td.creditor_GLAD_SLAPP_TIGER_AS.partyUuid);

  await helpers.loginAs(td.BOSTYRER);
}

tests {
  test("WHEN the user is an organisation, the request returns 400", function() {
    expect(res.status).to.equal(400);
  });

  test("THEN the error body reports validation error AM.VLD-00008 on QUERY/to", function() {
    const body = res.getBody();
    expect(body.code).to.equal("STD-00000");
    const err = body.validationErrors.find(e => e.code === "AM.VLD-00008");
    expect(err, "expected validation error AM.VLD-00008").to.not.be.undefined;
    expect(err.paths).to.include("QUERY/to");
  });
}
