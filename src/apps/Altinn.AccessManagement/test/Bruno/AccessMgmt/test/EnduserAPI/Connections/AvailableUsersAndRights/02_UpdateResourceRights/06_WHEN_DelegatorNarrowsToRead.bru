meta {
  name: 06_WHEN_DelegatorNarrowsToRead
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/connections/resources/rights?party={{party}}&to={{to}}&resource={{resource}}
  body: json
  auth: inherit
}

params:query {
  party: {{party}}
  to: {{to}}
  resource: {{resource}}
}

body:json {
  {
    "directRightKeys": ["{{aur_readKey}}"]
  }
}

docs {
  WHEN the delegator sends only the read key. The update replaces the delegated rights,
  so write is revoked.
}

script:pre-request {
  const { loginAs, testdata, scopes } = require("./test/EnduserAPI/Connections/AvailableUsersAndRights/helpers.js");
  const td = testdata();

  bru.setVar("party", td.delegator.partyUuid);
  bru.setVar("to", td.receiver.partyUuid);
  bru.setVar("resource", td.resource.refId);

  await loginAs(td.delegator, scopes.enduserSystemToOthersWrite);
}

tests {
  test("WHEN the rights are narrowed to read, the request returns 200", function() {
    expect(res.status).to.equal(200);
  });
}
