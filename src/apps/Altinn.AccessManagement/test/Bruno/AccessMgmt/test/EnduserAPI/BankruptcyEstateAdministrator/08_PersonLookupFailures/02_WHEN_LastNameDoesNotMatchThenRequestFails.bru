meta {
  name: 02_WHEN_LastNameDoesNotMatchThenRequestFails
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/bankruptcyestate/administrators?party={{party}}
  body: json
  auth: inherit
}

params:query {
  party: {{party}}
}

body:json {
  {
    "personIdentifier": "{{personIdentifier}}",
    "lastName": "{{lastName}}"
  }
}

docs {
  WHEN the bostyrer gives the assistant's SSN with a last name that does not match. Expects
  400 with validation error AM.VLD-00034 (external identifiers gave no result). This is the
  bostyrer's first failed lookup.
}

script:pre-request {
  const helpers = require("./test/EnduserAPI/BankruptcyEstateAdministrator/helpers.js");
  if (helpers.skipUnlessPersonLookupNegativesEnabled()) {
    return;
  }
  const td = helpers.testdata();

  bru.setVar("party", td.BOSTYRER.partyUuid);
  bru.setVar("personIdentifier", td.user_LUN_ANALYSE_GÅSTOL.pid);
  bru.setVar("lastName", "Feilnavnsen");

  await helpers.loginAs(td.BOSTYRER);
}

tests {
  test("WHEN the last name does not match, the request returns 400", function() {
    expect(res.status).to.equal(400);
  });

  test("THEN the error body reports validation error AM.VLD-00034 on /PersonIdentifier", function() {
    const body = res.getBody();
    expect(body.code).to.equal("STD-00000");
    const err = body.validationErrors.find(e => e.code === "AM.VLD-00034");
    expect(err, "expected validation error AM.VLD-00034").to.not.be.undefined;
    expect(err.paths).to.include("/PersonIdentifier");
  });
}
