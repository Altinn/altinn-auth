meta {
  name: 13_BUT_ToOthersScopeDoesNotReadTheAccessReceived
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/accessmanagement/api/v2/enduser/connections/activitylog?party={{party}}&direction=to&pageSize=1
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  direction: to
  pageSize: 1
}

docs {
  BUT the same token cannot read the access the party has received (`direction=to`),
  which needs `enduser:connections:fromothers.read`. The scope policy keys on the
  direction parameter and returns 403.
}

script:pre-request {
  const { loginAs, scopes, testdata } = require("./test/EnduserAPI/ActivityLog/helpers.js");
  const td = testdata().connections;

  bru.setVar("party", td.delegator.partyUuid);

  await loginAs(td.delegator, scopes.enduserSystemToOthersRead);
}

tests {
  test("BUT the to-others scope is refused on direction=to with 403", function() {
    expect(res.status).to.equal(403);
  });
}
