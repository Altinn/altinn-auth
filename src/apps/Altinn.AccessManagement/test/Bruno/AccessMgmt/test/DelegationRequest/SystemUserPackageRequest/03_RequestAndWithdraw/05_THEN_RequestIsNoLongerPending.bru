meta {
  name: 05_THEN_RequestIsNoLongerPending
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/systemuser/request/sent?organization={{organization}}&status=Pending&type=package
  body: none
  auth: inherit
}

params:query {
  organization: {{organization}}
  status: Pending
  type: package
}

docs {
  THEN the withdrawn request is no longer among the system user's pending sent requests.
}

script:pre-request {
  const { testdata, loginAsSystemUser } = require("./test/DelegationRequest/SystemUserPackageRequest/helpers.js");
  const td = testdata();

  bru.setVar("organization", td.recipient.orgno);

  await loginAsSystemUser(td.publicSectorConsumer.systemUser, td.publicSectorConsumer.orgno, td.publicSectorConsumer.orgno);
}

tests {
  test("THEN the sent requests can be listed, the request returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("THEN the withdrawn request is not pending", function() {
    const ids = res.getBody().data.map(r => r.id);
    expect(ids).to.not.include(bru.getVar("withdrawRequestId"));
  });
}
