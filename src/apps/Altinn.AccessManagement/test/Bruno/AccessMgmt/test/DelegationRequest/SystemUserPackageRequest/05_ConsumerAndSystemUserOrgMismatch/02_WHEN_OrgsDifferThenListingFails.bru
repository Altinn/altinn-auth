meta {
	name: 02_WHEN_OrgsDifferThenListingFails
	type: http
	seq: 2
}

get {
	url: {{baseUrl}}/accessmanagement/api/v1/systemuser/request/sent
	body: none
	auth: inherit
}

docs {
	WHEN the consumer is a public sector organisation but systemuser_org is another organisation,
	listing sent requests fails with 403.
}

script:pre-request {
	const { testdata, loginAsSystemUser } = require("./test/DelegationRequest/SystemUserPackageRequest/helpers.js");
	const td = testdata();

	await loginAsSystemUser(td.publicSectorConsumer.systemUser, td.publicSectorConsumer.orgno, td.privateConsumer.orgno);
}

tests {
	test("WHEN the consumer and system user organisation differ, the request returns 403", function() {
		expect(res.status).to.equal(403);
	});
}
