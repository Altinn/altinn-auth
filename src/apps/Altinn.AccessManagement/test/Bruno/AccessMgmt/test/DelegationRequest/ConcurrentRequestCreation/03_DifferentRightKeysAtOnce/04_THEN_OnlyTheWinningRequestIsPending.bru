meta {
	name: 04_THEN_OnlyTheWinningRequestIsPending
	type: http
	seq: 4
}

get {
	url: {{baseUrl}}/accessmanagement/api/v2/enduser/request/sent?party={{party}}&to={{to}}&status=Pending&type=resource
	body: none
	auth: inherit
}

params:query {
	party: {{party}}
	to: {{to}}
	status: Pending
	type: resource
}

docs {
	THEN the requester has exactly one pending request for the resource: the one the winning
	call returned, with the right it asked for. Two here is the bug in #3931.

	GET /accessmanagement/api/v2/enduser/request/sent?party=<requester>&to=<approver>&status=Pending&type=resource
}

script:pre-request {
	const { skipOutsideEnabledEnvironments, testdata, loginAs } = require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js");
	if (skipOutsideEnabledEnvironments({ waitsForFix: true })) {
		return;
	}

	const td = testdata();

	bru.setVar("party", td.requester.partyUuid);
	bru.setVar("to", td.approver.partyUuid);

	await loginAs(td.requester.innehaver);
}

tests {
	if (require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js").isSkipped()) {
		return;
	}

	const { testdata, isFor, readResults } = require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js");

	test("THEN the sent requests can be listed, the request returns 200", function() {
		expect(res.status).to.equal(200);
	});

	test("THEN only the winning request is pending, with the right it asked for", function() {
		// The calls were sent in this order: the first asked for cc_keyA, the second for cc_keyB.
		const results = readResults("03");
		const winnerIndex = results.findIndex(r => r.status === 200);
		expect(winnerIndex, "no call was answered with 200").to.not.equal(-1);
		const winner = results[winnerIndex];
		const askedFor = [bru.getVar(winnerIndex === 0 ? "cc_keyA" : "cc_keyB")];

		expect(winner.body.resource.requestedRightKeys, "the winning call's response").to.deep.equal(askedFor);

		const pending = res.getBody().data.filter(r => isFor(r, testdata().resource));
		expect(pending.map(r => r.id)).to.deep.equal([winner.body.id]);
		expect(pending[0].resource.requestedRightKeys, "the pending request").to.deep.equal(askedFor);
	});
}
