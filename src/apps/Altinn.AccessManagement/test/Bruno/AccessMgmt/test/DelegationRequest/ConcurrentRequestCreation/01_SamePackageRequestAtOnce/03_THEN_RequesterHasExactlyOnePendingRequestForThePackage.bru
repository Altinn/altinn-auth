meta {
	name: 03_THEN_RequesterHasExactlyOnePendingRequestForThePackage
	type: http
	seq: 3
}

get {
	url: {{baseUrl}}/accessmanagement/api/v2/enduser/request/sent?party={{party}}&to={{to}}&status=Pending&type=package
	body: none
	auth: inherit
}

params:query {
	party: {{party}}
	to: {{to}}
	status: Pending
	type: package
}

docs {
	THEN the requester has exactly one pending request for the package, the one every call
	returned. Two or more here is the bug in #3931.

	GET /accessmanagement/api/v2/enduser/request/sent?party=<requester>&to=<approver>&status=Pending&type=package
}

script:pre-request {
	const { skipOutsideEnabledEnvironments, testdata, loginAs } = require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js");
	if (skipOutsideEnabledEnvironments({ waitsForFix: true })) {
		return;
	}

	const td = testdata();

	bru.setVar("party", td.requester.partyUuid);
	bru.setVar("to", td.approver.partyUuid);

	await loginAs(td.requester.innehaver);
}

tests {
	if (require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js").isSkipped()) {
		return;
	}

	const { testdata, isFor, readResults } = require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js");

	test("THEN the sent requests can be listed, the request returns 200", function() {
		expect(res.status).to.equal(200);
	});

	test("THEN there is exactly one pending request for the package, the one the calls returned", function() {
		const pending = res.getBody().data.filter(r => isFor(r, testdata().packages[0]));
		expect(pending.map(r => r.id)).to.deep.equal([readResults("02")[0].body.id]);
	});
}
