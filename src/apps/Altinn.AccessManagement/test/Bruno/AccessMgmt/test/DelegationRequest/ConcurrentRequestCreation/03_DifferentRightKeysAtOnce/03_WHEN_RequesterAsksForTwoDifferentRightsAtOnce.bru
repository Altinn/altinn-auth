meta {
	name: 03_WHEN_RequesterAsksForTwoDifferentRightsAtOnce
	type: http
	seq: 3
}

get {
	url: {{baseUrl}}/accessmanagement/api/v2/enduser/request/sent?party={{party}}&to={{to}}&status=Pending&type=resource
	body: none
	auth: inherit
}

params:query {
	party: {{party}}
	to: {{to}}
	status: Pending
	type: resource
}

docs {
	WHEN the requester asks for one right on the resource and, at the same time, for another.

	POST /accessmanagement/api/v2/enduser/request/resource?party=<requester>&to=<approver>&resource=<id>
	with `{ "requestedRightKeys": ["<key A>"] }` and `{ "requestedRightKeys": ["<key B>"] }`

	While a request for the resource is pending, a request for other rights gives 409 with
	AM-00054. Exactly one of the two calls should win.

	The calls under test are sent at the same time from the pre-request script, with axios and
	Promise.all, because the Bruno runner sends the requests of a collection one after another.
	Their status codes and bodies are stored in `cc_results` for the tests below and the later
	steps. The request of this step itself only lists the requester's pending requests afterwards.

	The race is not certain to happen on every run, since the calls travel over the network. A
	failing run proves the bug; a passing run makes it unlikely, but does not prove it is gone.
}

script:pre-request {
	const axios = require("axios");
	const { skipOutsideEnabledEnvironments, testdata, loginAs, sendAtOnce, storeResults, paths, parallelCalls } = require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js");
	if (skipOutsideEnabledEnvironments({ waitsForFix: true })) {
		return;
	}

	const td = testdata();

	bru.setVar("party", td.requester.partyUuid);
	bru.setVar("to", td.approver.partyUuid);

	await loginAs(td.requester.innehaver);

	const query = `party=${td.requester.partyUuid}&to=${td.approver.partyUuid}`;
	if (!bru.getVar("cc_keyA") || !bru.getVar("cc_keyB")) {
		throw new Error("cc_keyA and cc_keyB are not set: run the scenario from step 01, and check that step 02 succeeded.");
	}

	const path = `${paths.v2}/resource?${query}&resource=${encodeURIComponent(td.resource)}`;
	const calls = [
		{ path, body: { requestedRightKeys: [bru.getVar("cc_keyA")] } },
		{ path, body: { requestedRightKeys: [bru.getVar("cc_keyB")] } },
	];
	storeResults(await sendAtOnce(axios, calls, `${paths.v2}/sent?${query}&status=Pending&type=resource`));
}

tests {
	if (require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js").isSkipped()) {
		return;
	}

	const { readResults } = require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js");
	const results = readResults("03");

	test("WHEN exactly one call returns 200 and the other 409, none 500", function() {
		expect(results.map(r => r.status).sort()).to.deep.equal([200, 409]);
	});

	test("THEN the losing call is told a request with other rights is pending (AM-00054)", function() {
		const loser = results.find(r => r.status === 409);
		expect(loser.body.code).to.equal("AM-00054");
	});
}
