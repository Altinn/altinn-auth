meta {
  name: 01_GIVEN_NoPendingRequestFromSystemUser
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/enduser/request/received?party={{party}}&from={{systemUser}}&status=Pending&type=package
  body: none
  auth: inherit
}

params:query {
  party: {{party}}
  from: {{systemUser}}
  status: Pending
  type: package
}

docs {
  GIVEN the recipient has no pending package request from the system user.

  Idempotent reset: lists pending requests from the system user and rejects each one, so
  leftovers from earlier or crashed runs never break the scenario.
}

script:pre-request {
  bru.setVar("rejectRequestId", null);

  const { testdata, loginAs } = require("./test/DelegationRequest/SystemUserPackageRequest/helpers.js");
  const td = testdata();

  bru.setVar("party", td.recipient.partyUuid);
  bru.setVar("systemUser", td.publicSectorConsumer.systemUser.partyUuid);

  await loginAs(td.recipient.dagligleder);
}

script:post-response {
  const axios = require("axios");
  const pending = (res.getBody() && res.getBody().data) || [];
  for (const request of pending) {
    await axios.put(
      `${bru.getEnvVar("baseUrl")}/accessmanagement/api/v1/enduser/request/received/reject?party=${bru.getVar("party")}&id=${request.id}`,
      null,
      { headers: { Authorization: `Bearer ${bru.getVar("bearerToken")}` } });
  }
}

tests {
  test("GIVEN the received requests can be listed, the request returns 200", function() {
    expect(res.status).to.equal(200);
  });
}
