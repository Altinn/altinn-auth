meta {
	name: 03_WHEN_RequesterRequestsOneRight
	type: http
	seq: 3
}

post {
	url: {{baseUrl}}/accessmanagement/api/v2/enduser/request/resource?party={{party}}&to={{to}}&resource={{resource}}
	body: json
	auth: inherit
}

params:query {
	party: {{party}}
	to: {{to}}
	resource: {{resource}}
}

headers {
	Content-Type: application/json
	Accept: application/json
}

body:json {
	{
		"requestedRightKeys": ["{{rk_keyA}}"]
	}
}

docs {
	WHEN the requester asks the approver for one right on the resource.

	POST /accessmanagement/api/v2/enduser/request/resource?party=<requester>&to=<approver>&resource=<id>

	Scope `altinn:portal/enduser` or `altinn:accessmanagement/enduser:requests.write`. `party`
	is the party asking for access, `to` the party asked to grant it; the two must already be
	connected. The optional body `{ "requestedRightKeys": [...] }` names the rights asked for,
	as right keys from the resource policy. Leave it out to ask for the whole resource. Each key
	must exist in the policy and be delegable, otherwise 400 with AM.VLD-00054 (not in the
	policy) or AM.VLD-00055 (not delegable), pointing at `/requestedRightKeys/<index>`.
	Unknown fields in the body, such as `rightKeys`, give 400. While a request between the same
	parties for the resource is pending, sending the same keys returns it; other keys, or the
	whole resource instead of keys or the other way round, give 409 with AM-00053.

	Returns 200 with the v2 request: `status` is a plain string that clients must accept
	unknown values of, and the requested keys are in `resource.requestedRightKeys`.
}

script:pre-request {
	const { skipOutsideEnabledEnvironments, testdata, loginAs } = require("./test/DelegationRequest/ResourceRequestRightKeysV2/helpers.js");
	if (skipOutsideEnabledEnvironments()) {
		return;
	}

	const td = testdata();

	bru.setVar("party", td.requester.partyUuid);
	bru.setVar("to", td.approver.partyUuid);
	bru.setVar("resource", td.resource);

	await loginAs(td.requester.innehaver);
}

script:post-response {
	const body = res.getBody();
	if (res.status === 200 && body && body.id) {
		bru.setVar("rk_requestId", body.id);
	}
}

tests {
	test("WHEN the request is created through v2, the request returns 200", function() {
		expect(res.status).to.equal(200);
	});

	test("THEN the request is pending with the one requested right", function() {
		const body = res.getBody();
		expect(body.status).to.equal("Pending");
		expect(body.resource.requestedRightKeys).to.deep.equal([bru.getVar("rk_keyA")]);
	});
}
