meta {
	name: 01_GIVEN_NoPendingRequest
	type: http
	seq: 1
}

get {
	url: {{baseUrl}}/accessmanagement/api/v2/enduser/request/sent?party={{party}}&to={{to}}&status=Pending&type=package
	body: none
	auth: inherit
}

params:query {
	party: {{party}}
	to: {{to}}
	status: Pending
	type: package
}

docs {
	GIVEN the requester has no pending request to the approver for either package.

	GET /accessmanagement/api/v2/enduser/request/sent?party=<requester>&to=<approver>&status=Pending&type=package

	Idempotent reset: the post-response script withdraws every pending request for either package, so
	leftovers from earlier or crashed runs, including duplicates the bug in #3931 created,
	never break the scenario. Withdrawing sends no notifications.
}

script:pre-request {
	const { skipOutsideEnabledEnvironments, testdata, loginAs, clearScenarioVars } = require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js");
	if (skipOutsideEnabledEnvironments()) {
		return;
	}

	const td = testdata();

	clearScenarioVars();
	bru.setVar("party", td.requester.partyUuid);
	bru.setVar("to", td.approver.partyUuid);

	await loginAs(td.requester.innehaver);
}

script:post-response {
	if (require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js").isSkipped()) {
		return;
	}

	const axios = require("axios");
	const { testdata, withdrawPending } = require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js");

	if (res.status === 200) {
		const td = testdata();
		await withdrawPending(axios, td, res.getBody().data, td.packages);
	}
}

tests {
	if (require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js").isSkipped()) {
		return;
	}

	test("GIVEN the sent requests can be listed through v2, the request returns 200", function() {
		expect(res.status).to.equal(200);
	});
}
