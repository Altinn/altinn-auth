meta {
	name: 05_CLEANUP_ApproverRejectsThePendingRequests
	type: http
	seq: 5
}

get {
	url: {{baseUrl}}/accessmanagement/api/v2/enduser/request/received?party={{party}}&from={{from}}&status=Pending&type=package
	body: none
	auth: inherit
}

params:query {
	party: {{party}}
	from: {{from}}
	status: Pending
	type: package
}

docs {
	CLEANUP the approver rejects every pending request from the requester for the package, so the
	scenario can be rerun. Requests cannot be deleted. All of them are rejected, not only the one
	the scenario expects, because while #3931 is unfixed a run can leave duplicates behind.

	GET /accessmanagement/api/v2/enduser/request/received?party=<approver>&from=<requester>&status=Pending&type=package
	followed by PUT /accessmanagement/api/v2/enduser/request/received/reject?party=<approver>&id=<id> for each.
}

script:pre-request {
	const { skipOutsideEnabledEnvironments, testdata, loginAs } = require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js");
	if (skipOutsideEnabledEnvironments({ waitsForFix: true })) {
		return;
	}

	const td = testdata();

	bru.setVar("party", td.approver.partyUuid);
	bru.setVar("from", td.requester.partyUuid);

	await loginAs(td.approver);
}

script:post-response {
	if (require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js").isSkipped()) {
		return;
	}

	const axios = require("axios");
	const { testdata, rejectPending } = require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js");

	if (res.status === 200) {
		const td = testdata();
		await rejectPending(axios, td, res.getBody().data, [td.packages[0]]);
	}
}

tests {
	if (require("./test/DelegationRequest/ConcurrentRequestCreation/helpers.js").isSkipped()) {
		return;
	}

	test("CLEANUP the received requests can be listed, the request returns 200", function() {
		expect(res.status).to.equal(200);
	});
}
