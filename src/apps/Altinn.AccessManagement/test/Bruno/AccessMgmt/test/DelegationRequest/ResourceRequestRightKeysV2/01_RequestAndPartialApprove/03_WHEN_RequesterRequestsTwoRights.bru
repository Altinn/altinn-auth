meta {
	name: 03_WHEN_RequesterRequestsTwoRights
	type: http
	seq: 3
}

post {
	url: {{baseUrl}}/accessmanagement/api/v2/enduser/request/resource?party={{party}}&to={{to}}&resource={{resource}}
	body: json
	auth: inherit
}

params:query {
	party: {{party}}
	to: {{to}}
	resource: {{resource}}
}

headers {
	Content-Type: application/json
	Accept: application/json
}

body:json {
	{
		"requestedRightKeys": ["{{rk_keyA}}", "{{rk_keyB}}"]
	}
}

docs {
	WHEN the requester asks the approver for two rights on the resource.

	POST /accessmanagement/api/v2/enduser/request/resource?party=<requester>&to=<approver>&resource=<id>

	Scope `altinn:portal/enduser` or `altinn:accessmanagement/enduser:requests.write`. `party`
	is the party asking for access, `to` the party asked to grant it; the two must already be
	connected. The optional body `{ "requestedRightKeys": [...] }` names the rights asked for,
	as right keys from the resource policy. Leave it out to ask for the whole resource. Each key
	must exist in the policy and be delegable, otherwise 400 with AM.VLD-00054 (not in the
	policy) or AM.VLD-00055 (not delegable), pointing at `/requestedRightKeys/<index>`.

	Returns 200 with the v2 request: `status` is a plain string that clients must accept
	unknown values of, and the requested keys are in `resource.requestedRightKeys`.
}

script:pre-request {
	const { testdata, loginAs } = require("./test/DelegationRequest/ResourceRequestRightKeysV2/helpers.js");
	const td = testdata();

	bru.setVar("party", td.requester.partyUuid);
	bru.setVar("to", td.approver.partyUuid);
	bru.setVar("resource", td.resource);

	await loginAs(td.requester.innehaver);
}

script:post-response {
	const body = res.getBody();
	if (res.status === 200 && body && body.id) {
		bru.setVar("rk_requestId", body.id);
	}
}

tests {
	const { testdata } = require("./test/DelegationRequest/ResourceRequestRightKeysV2/helpers.js");
	const td = testdata();
	const guid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

	test("WHEN the request is created through v2, the request returns 200", function() {
		expect(res.status).to.equal(200);
	});

	test("THEN the request is a pending resource request from the requester to the approver", function() {
		const body = res.getBody();
		expect(body.id).to.match(guid);
		expect(body.status).to.equal("Pending");
		expect(body.type).to.equal("resource");
		expect(body.resource.referenceId).to.equal(td.resource);
		expect(body.from.id).to.equal(td.requester.partyUuid);
		expect(body.to.id).to.equal(td.approver.partyUuid);
	});

	test("THEN the requested rights are on the resource, and nothing is approved yet", function() {
		const body = res.getBody();
		expect(body.resource.requestedRightKeys).to.have.members([bru.getVar("rk_keyA"), bru.getVar("rk_keyB")]);
		expect(body.resource).to.not.have.property("approvedRightKeys");
	});

	test("THEN v2 has no separate statusV2", function() {
		expect(res.getBody()).to.not.have.property("statusV2");
	});
}
