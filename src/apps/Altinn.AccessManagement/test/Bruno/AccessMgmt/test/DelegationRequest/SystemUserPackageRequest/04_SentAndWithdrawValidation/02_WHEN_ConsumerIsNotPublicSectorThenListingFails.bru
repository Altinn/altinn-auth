meta {
  name: 02_WHEN_ConsumerIsNotPublicSectorThenListingFails
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/accessmanagement/api/v1/systemuser/request/sent
  body: none
  auth: inherit
}

docs {
  WHEN the system user belongs to an organisation that is not KOMM, FYLK or STAT, listing sent
  requests fails with 403.
}

script:pre-request {
  const { testdata, loginAsSystemUser } = require("./test/DelegationRequest/SystemUserPackageRequest/helpers.js");
  const td = testdata();

  await loginAsSystemUser(td.privateConsumer.systemUser, td.privateConsumer.orgno, td.privateConsumer.orgno);
}

tests {
  test("WHEN the consumer is not public sector, the request returns 403", function() {
    expect(res.status).to.equal(403);
  });
}
