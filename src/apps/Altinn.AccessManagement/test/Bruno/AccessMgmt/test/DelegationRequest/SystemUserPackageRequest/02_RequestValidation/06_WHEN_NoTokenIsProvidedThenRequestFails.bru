meta {
  name: 06_WHEN_NoTokenIsProvidedThenRequestFails
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/systemuser/request/package?organization={{organization}}&package={{package}}
  body: none
  auth: none
}

params:query {
  organization: {{organization}}
  package: {{package}}
}

docs {
  WHEN no token is provided, the request fails with 401.
}

script:pre-request {
  const { testdata } = require("./test/DelegationRequest/SystemUserPackageRequest/helpers.js");
  const td = testdata();

  bru.setVar("organization", td.recipient.orgno);
  bru.setVar("package", td.package);
}

tests {
  test("WHEN no token is provided, the request returns 401", function() {
    expect(res.status).to.equal(401);
  });
}
