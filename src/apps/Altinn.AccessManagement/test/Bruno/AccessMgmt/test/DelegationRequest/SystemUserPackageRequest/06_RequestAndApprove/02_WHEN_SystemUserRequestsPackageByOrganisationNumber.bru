meta {
	name: 02_WHEN_SystemUserRequestsPackageByOrganisationNumber
	type: http
	seq: 2
}

post {
	url: {{baseUrl}}/accessmanagement/api/v1/systemuser/request/package?organization={{organization}}&package={{package}}
	body: none
	auth: inherit
}

params:query {
	organization: {{organization}}
	package: {{package}}
}

docs {
	WHEN the system user requests the package from the recipient, identified by organisation number.

	Expects 200 with a pending request.
}

script:pre-request {
	const { testdata, loginAsSystemUser } = require("./test/DelegationRequest/SystemUserPackageRequest/helpers.js");
	const td = testdata();

	bru.setVar("organization", td.recipient.orgno);
	bru.setVar("package", td.package);

	await loginAsSystemUser(td.publicSectorConsumer.systemUser, td.publicSectorConsumer.orgno, td.publicSectorConsumer.orgno);
}

script:post-response {
	const body = res.getBody();
	if (body && body.id) {
		bru.setVar("approveRequestId", body.id);
	} else {
		console.log("Request creation did not return an id. Status: " + res.status + " Body: " + JSON.stringify(body));
	}
}

tests {
	test("WHEN the system user requests the package, the request returns 200", function() {
		expect(res.status).to.equal(200);
	});

	test("THEN the request is pending", function() {
		expect(res.getBody().status).to.equal("Pending");
	});
}
