meta {
	name: 04_WHEN_ServiceOwnerCreatesTheSamePackageRequestAgain
	type: http
	seq: 4
}

post {
	url: {{baseUrl}}/accessmanagement/api/v1/serviceowner/delegationrequests/package
	body: json
	auth: inherit
}

headers {
	Content-Type: application/json
	Accept: application/json
}

body:json {
	{
		"from": "urn:altinn:person:identifier-no:{{requesterPid}}",
		"to": "urn:altinn:organization:identifier-no:{{orgNo}}",
		"package": "{{reference}}"
	}
}

docs {
	WHEN the service owner creates the same package request again, while the first one is pending.

	POST /accessmanagement/api/v1/serviceowner/delegationrequests/package

	The issue asks for duplicates to be prevented, not for a particular response, so this step
	accepts either 202 with the pending request that already exists, or 409. Today it answers
	202 with a new request in status Draft (#5028), which fails the step.
}

script:pre-request {
	const { skipOutsideEnabledEnvironments, testdata, loginAsServiceOwner } = require("./utils/serviceOwnerRequestWhilePending.js");
	if (skipOutsideEnabledEnvironments()) {
		return;
	}

	const td = testdata();

	bru.setVar("requesterPid", td.requester.pid);
	bru.setVar("orgNo", td.organization.orgNo);
	bru.setVar("reference", td.package);

	await loginAsServiceOwner();
}

tests {
	if (require("./utils/serviceOwnerRequestWhilePending.js").isSkipped()) {
		return;
	}

	test("WHEN the request is answered with 202 or 409, not an error", function() {
		expect(res.status).to.be.oneOf([202, 409]);
	});

	test("THEN no new request is created: the answer is the pending request or a conflict", function() {
		if (res.status === 409) {
			return;
		}

		const body = res.getBody();
		expect(body.id, "a new request was created beside the pending one (#5028)").to.equal(bru.getVar("sop_requestId"));
		expect(body.status).to.equal("Pending");
	});
}
