meta {
  name: 05_CLEANUP_ServiceOwnerWithdrawsRequest
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/accessmanagement/api/v1/serviceowner/delegationrequests/{{so_resourceRequestId}}/withdraw
  body: none
  auth: inherit
}

docs {
  CLEANUP the service owner withdraws the request.

  PUT /accessmanagement/api/v1/serviceowner/delegationrequests/{id}/withdraw, scope
  `altinn:serviceowner/delegationrequests.write`. Only the service owner that created
  the request can withdraw it, and only while it is Draft or Pending. Returns 200 with
  "Withdrawn".
}

script:pre-request {
  const { td, loginAsServiceOwner, scopes } = require("./test/DelegationRequest/ServiceOwnerDelegationRequests/helpers.js");
  const data = td();

  bru.setVar("grantorPid", data.delegationRequest.grantor.pid);
  bru.setVar("requesterPid", data.delegationRequest.requester.pid);
  bru.setVar("requestResource", data.delegationRequest.resource);
  bru.setVar("requestPackage", data.delegationRequest.package);

  await loginAsServiceOwner(data.serviceOwners.ttd, scopes.delegationRequestsWrite);
}

tests {
  test("CLEANUP the withdraw returns 200 with Withdrawn", function() {
    expect(res.status).to.equal(200);
    expect(res.getBody()).to.equal("Withdrawn");
  });
}
