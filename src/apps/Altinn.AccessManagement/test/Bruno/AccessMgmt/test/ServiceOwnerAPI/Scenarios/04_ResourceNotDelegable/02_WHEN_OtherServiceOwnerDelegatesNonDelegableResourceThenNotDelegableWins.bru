meta {
  name: 02_WHEN_OtherServiceOwnerDelegatesNonDelegableResourceThenNotDelegableWins
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/serviceowner/connections/resources
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "from": "urn:altinn:person:identifier-no:{{grantorPid}}",
    "to": "urn:altinn:person:identifier-no:{{recipientPid}}",
    "resource": "{{notDelegableResource}}",
    "rightKeys": {
      "directRightKeys": ["read"]
    }
  }
}

docs {
  WHEN a service owner that does not own a non-delegable resource delegates it the request
  fails with 400 AM-00042, not 403 AM-00048: the Delegable flag is checked before
  ownership.
}

script:pre-request {
  const { td, loginAsServiceOwner, scopes, serviceOwners } = require("./test/ServiceOwnerAPI/Scenarios/helpers.js");
  const data = td();

  bru.setVar("grantorPid", data.resourceDelegation.grantor.pid);
  bru.setVar("recipientPid", data.resourceDelegation.recipient.pid);
  bru.setVar("notDelegableResource", data.resourceDelegation.notDelegableResource);

  await loginAsServiceOwner(serviceOwners.skd, scopes.resourceDelegationWrite);
}

tests {
  const { td } = require("./test/ServiceOwnerAPI/Scenarios/helpers.js");

  test("WHEN another service owner delegates a non-delegable resource, the request returns 400", function() {
    expect(res.status).to.equal(400);
  });

  test("THEN the problem body carries AM-00042", function() {
    const body = res.getBody();
    expect(body.status).to.equal(400);
    expect(body.code).to.equal("AM-00042");
    expect(body.detail).to.equal("Resource '" + td().resourceDelegation.notDelegableResource + "' is marked as not delegable in the Resource Registry");
  });

  test("AND the ownership check is not reached", function() {
    expect(res.status).to.not.equal(403);
    expect(res.getBody().code).to.not.equal("AM-00048");
  });
}
