meta {
  name: 07_WHEN_OtherServiceOwnerDelegatesThenRequestIsForbidden
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/serviceowner/connections/resources
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "from": "urn:altinn:person:identifier-no:{{grantorPid}}",
    "to": "urn:altinn:person:identifier-no:{{recipientPid}}",
    "resource": "{{resource}}",
    "rightKeys": {
      "directRightKeys": ["read"]
    }
  }
}

docs {
  WHEN a service owner that does not own a delegable resource delegates it the request is
  forbidden: 403 AM-00048, and no delegation is created.
}

script:pre-request {
  const { td, loginAsServiceOwner, scopes, serviceOwners } = require("./test/ServiceOwnerAPI/Scenarios/helpers.js");
  const data = td();

  bru.setVar("grantorPid", data.resourceDelegation.grantor.pid);
  bru.setVar("recipientPid", data.resourceDelegation.recipient.pid);
  bru.setVar("resource", data.resourceDelegation.resource);

  await loginAsServiceOwner(serviceOwners.skd, scopes.resourceDelegationWrite);
}

tests {
  test("WHEN another service owner delegates the resource, the request returns 403", function() {
    expect(res.status).to.equal(403);
  });

  test("THEN the problem body carries AM-00048", function() {
    const body = res.getBody();
    expect(body.status).to.equal(403);
    expect(body.code).to.equal("AM-00048");
  });
}
