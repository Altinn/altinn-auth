meta {
  name: 03_WHEN_TokenLacksScopeThenRequestIsForbidden
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/serviceowner/authorizedparties
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "type": "urn:altinn:person:identifier-no",
    "value": "{{subjectPid}}"
  }
}

docs {
  WHEN the token carries a service owner scope other than the authorized parties scopes
  the request is forbidden with 403.
}

script:pre-request {
  const { td, loginAsServiceOwner, scopes, serviceOwners } = require("./test/ServiceOwnerAPI/Scenarios/helpers.js");
  const data = td();

  bru.setVar("subjectPid", data.resourceDelegation.grantor.pid);
  bru.setVar("resource", data.resourceDelegation.resource);

  await loginAsServiceOwner(serviceOwners.digdir, scopes.resourceDelegationWrite);
}

tests {
  test("WHEN the token lacks the authorized parties scope, the request returns 403", function() {
    expect(res.status).to.equal(403);
  });
}
