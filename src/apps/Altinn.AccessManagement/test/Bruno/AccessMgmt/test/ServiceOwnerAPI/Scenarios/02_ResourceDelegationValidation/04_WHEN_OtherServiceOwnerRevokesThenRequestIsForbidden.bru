meta {
  name: 04_WHEN_OtherServiceOwnerRevokesThenRequestIsForbidden
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/serviceowner/connections/resources/revoke
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "from": "urn:altinn:person:identifier-no:{{grantorPid}}",
    "to": "urn:altinn:person:identifier-no:{{recipientPid}}",
    "resource": "{{resource}}"
  }
}

docs {
  WHEN a service owner that does not own the resource calls revoke the request is
  forbidden: 403 AM-00048. Ownership is decided by comparing the organization number in
  the token's consumer claim with the resource provider's organization number.
}

script:pre-request {
  const { td, loginAsServiceOwner, scopes, serviceOwners } = require("./test/ServiceOwnerAPI/Scenarios/helpers.js");
  const data = td();

  bru.setVar("grantorPid", data.resourceDelegation.grantor.pid);
  bru.setVar("recipientPid", data.resourceDelegation.recipient.pid);
  bru.setVar("resource", data.resourceDelegation.resource);

  await loginAsServiceOwner(serviceOwners.skd, scopes.resourceDelegationWrite);
}

tests {
  test("WHEN another service owner revokes, the request returns 403", function() {
    expect(res.status).to.equal(403);
  });

  test("THEN the problem body carries AM-00048", function() {
    const body = res.getBody();
    expect(body.status).to.equal(403);
    expect(body.code).to.equal("AM-00048");
  });
}
