meta {
  name: 02_WHEN_DelegationWithoutRightKeysThenRequestFails
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/accessmanagement/api/v1/serviceowner/connections/resources
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "from": "urn:altinn:person:identifier-no:{{grantorPid}}",
    "to": "urn:altinn:person:identifier-no:{{recipientPid}}",
    "resource": "{{resource}}"
  }
}

docs {
  WHEN a right is delegated without `rightKeys` the request fails with 400 AM-00033.
  The check runs before any assignment is created.
}

script:pre-request {
  const { td, loginAsServiceOwner, scopes, serviceOwners } = require("./test/ServiceOwnerAPI/Scenarios/helpers.js");
  const data = td();

  bru.setVar("grantorPid", data.resourceDelegation.grantor.pid);
  bru.setVar("recipientPid", data.resourceDelegation.recipient.pid);
  bru.setVar("resource", data.resourceDelegation.resource);

  await loginAsServiceOwner(serviceOwners.digdir, scopes.resourceDelegationWrite);
}

tests {
  test("WHEN no right key is given, the request returns 400", function() {
    expect(res.status).to.equal(400);
  });

  test("THEN the problem body carries AM-00033", function() {
    const body = res.getBody();
    expect(body.status).to.equal(400);
    expect(body.code).to.equal("AM-00033");
    expect(body.detail).to.equal("No right key provided");
  });
}
