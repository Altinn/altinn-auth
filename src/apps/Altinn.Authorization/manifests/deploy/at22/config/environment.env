ASPNETCORE_ENVIRONMENT=Staging

# Pgsql
PostgreSQLSettings__AdminConnectionString=Host=at22-authorization-postgres.altinn.cloud;Port=5432;Username=platform_authorization_admin;Password={0};Database=authorizationdb;SslMode=Require;Trust Server Certificate=true;Maximum Pool Size=2;
PostgreSQLSettings__ConnectionString=Host=at22-authorization-postgres.altinn.cloud;Port=5432;Username=platform_authorization;Password={0};Database=authorizationdb;SslMode=Require;Trust Server Certificate=true;Maximum Pool Size=6;
PostgreSQLSettings__EnableDBConnection="false"

# General Settings
GeneralSettings__UseStorageApiForInstanceAuthInfo=true
GeneralSettings__BridgeApiEndpoint=https://at22.altinn.cloud/sblbridge/
