meta {
	name: 02_GIVEN_KeyRole_WHEN_DirectAndHierarchy_THEN_NotPermit
	type: http
	seq: 2
}

post {
	url: {{baseUrl}}/authorization/api/v1/authorize
	body: json
	auth: inherit
}

headers {
	Content-Type: application/json
	Ocp-Apim-Subscription-Key: {{apimSubscriptionKey}}
}

body:json {
	{
			"Request": {
					"ReturnPolicyIdList": false,
					"AccessSubject": [
							{
									"Attribute": [
											{
													"AttributeId": "urn:altinn:person:identifier-no",
													"Value": "{{subjectPersonId}}"
											}
									]
							}
					],
					"Action": [
							{
									"Attribute": [
											{
													"AttributeId": "urn:oasis:names:tc:xacml:1.0:action:action-id",
													"Value": "read",
													"DataType": "http://www.w3.org/2001/XMLSchema#string"
											}
									]
							}
					],
					"Resource": [
							{
									"Attribute": [
											{
													"AttributeId": "urn:altinn:resource",
													"Value": "{{resourceId}}"
											},
											{
													"AttributeId": "urn:altinn:organization:identifier-no",
													"Value": "{{resourceOrganizationId}}",
													"DataType": "http://www.w3.org/2001/XMLSchema#string"
											},
											{
													"AttributeId": "urn:altinn:authorization:access-restriction",
													"Value": "DirectAndHierarchy"
											}
									]
							}
					]
			}
	}
}

script:pre-request {
	const sharedtestdata = require(`./testdata/shared.js`);
	const testdata = require(`./testdata/accesspackage-resource-auth/${bru.getEnvVar("tokenEnv")}.js`);

	bru.setVar("requestName", "AccessRestriction_02_KeyRole_DirectAndHierarchy_NotPermit");
	bru.setVar("resourceId", testdata.resources.revisorattestererPckgResourceId);
	bru.setVar("subjectPersonId", testdata.REGN_ULASTELIG_RETTFERDIG_TIGER.dagligleder.pid);
	bru.setVar("resourceOrganizationId", testdata.REGN_ULASTELIG_RETTFERDIG_TIGER.client_rightholderOrg2.orgno);

	var getTokenParameters = {
		auth_tokenType: sharedtestdata.authTokenType.enterprise,
		auth_scopes: `${sharedtestdata.auth_scopes.authorize} ${sharedtestdata.auth_scopes.authorizeAdmin}`,
		auth_org: sharedtestdata.serviceOwners.ttd.org,
		auth_orgNo: sharedtestdata.serviceOwners.ttd.orgno,
	}

	const testTokenGenerator = require(`./TestToolsTokenGenerator.js`);
	const token = await testTokenGenerator.getToken(getTokenParameters);
	bru.setVar("bearerToken", token);
}

tests {
	test("Decision_" + bru.getVar("requestName"), function() {
		const data = res.getBody();
		expect(res.status).to.equal(200);
		expect(data.response[0].decision).to.not.equal("Permit");
		expect(data.response[0].decision).to.not.equal("Indeterminate");
	});
}

docs {
	DirectAndHierarchy must exclude access inherited through keyroles, so the same request that permits by default must not permit.
}
