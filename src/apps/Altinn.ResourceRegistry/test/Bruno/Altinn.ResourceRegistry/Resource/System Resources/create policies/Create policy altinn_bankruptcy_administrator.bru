meta {
	name: Create policy altinn_bankruptcy_administrator
	type: http
	seq: 6
}

post {
	url: {{baseUrl}}/resourceregistry/api/v1/resource/{{id}}/policy
	body: multipartForm
	auth: inherit
}

headers {
	Content-Type: multipart/form-data
}

body:multipart-form {
	policyFile: @file(Testdata/Policies/altinn_bankruptcy_estate_admin.xacml)
}

vars:pre-request {
	id: altinn_bankruptcy_estate_admin
}

script:pre-request {
	const sharedtestdata = require(`./Testdata/sharedtestdata.js`);
	
	var getTokenParameters = {
		auth_orgNo: sharedtestdata.serviceOwners.digdir.orgno,
		auth_org: sharedtestdata.serviceOwners.digdir.org,
		auth_tokenType: sharedtestdata.authTokenType.enterprise,
		auth_scopes: sharedtestdata.auth_scopes.resourceregistryAdmin
	}
	const testTokenGenerator = require(`./TestToolsTokenGenerator.js`);
	const token = await testTokenGenerator.getToken(getTokenParameters);
	
	bru.setVar("bearerToken",  token);
	
	
	
}
