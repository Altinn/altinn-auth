<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Clear of the import warning baseline in Directory.Build.props (#4597), so opt out of it and
      let CI's -warnaserror apply again: only NuGet audit advisories stay non-fatal.
      Drop this once the baseline is removed.
    -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Register\**" />
    <EmbeddedResource Remove="Register\**" />
    <None Remove="Register\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ResourceRegistry\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Altinn.Register.Contracts" Version="1.8.0" />
    <PackageReference Include="Microsoft.FeatureManagement" Version="4.8.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <ProjectReference Include="..\Altinn.Platform.Authentication.Core\Altinn.Platform.Authentication.Core.csproj" />
  </ItemGroup>
</Project>
