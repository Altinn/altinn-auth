@page "/provider/{Id:guid}"
@inherits EnvironmentPageBase
@inject ProviderDetailsService DataService

<PageTitle>Provider – @(_data?.Provider.Name ?? Id.ToString())</PageTitle>

@if (Loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (Error is not null)
{
    <MudAlert Severity="Severity.Error">@Error</MudAlert>
}
else if (_data is null)
{
    <MudAlert Severity="Severity.Error">Provider not found: @Id</MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-6">
        <BackButton />
        <MudText Typo="Typo.h4">@_data.Provider.Name</MudText>
        <MudChip T="string" Color="Color.Default" Size="Size.Small">@(_data.Provider.Type?.Name ?? "–")</MudChip>
    </MudStack>

    <MudGrid>
        <MudItem xs="12" md="6">
            <SummaryCard>
                <SummaryRow Label="Id" Monospace="true">@_data.Provider.Id</SummaryRow>
                <SummaryRow Label="Name">@_data.Provider.Name</SummaryRow>
                <SummaryRow Label="Code" Monospace="true">@(_data.Provider.Code ?? "–")</SummaryRow>
                <SummaryRow Label="RefId" Monospace="true">@(_data.Provider.RefId ?? "–")</SummaryRow>
                <SummaryRow Label="Type">@(_data.Provider.Type?.Name ?? _data.Provider.TypeId.ToString())</SummaryRow>
                @if (!string.IsNullOrEmpty(_data.Provider.LogoUrl))
                {
                    <SummaryRow Label="Logo">
                        <img src="@_data.Provider.LogoUrl" alt="Logo" style="max-height:32px" />
                    </SummaryRow>
                }
            </SummaryCard>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h5" Class="mt-8 mb-3">Owned by this provider</MudText>
    <MudTabs Elevation="1" Rounded="false" ApplyEffectsToContainer="true">

        <MudTabPanel Text="@($"Resources ({_data.Resources.Count})")"
                     Icon="@Icons.Material.Filled.Api">
            <MudTable Items="_data.Resources" Hover="true" Dense="true" Class="pa-0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>RefId</MudTh>
                    <MudTh>Description</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudLink Href="@($"/resource/{context.Id}")">@context.Name</MudLink>
                    </MudTd>
                    <MudTd DataLabel="Type">
                        <MudText Typo="Typo.body2">@(context.Type?.Name ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="RefId">
                        <MudText Typo="Typo.caption" Class="mono">@(context.RefId ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Description">
                        <MudText Typo="Typo.body2">@(context.Description ?? "–")</MudText>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">No resources for this provider.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@($"Packages ({_data.Packages.Count})")"
                     Icon="@Icons.Material.Filled.Inventory2">
            <MudTable Items="_data.Packages" Hover="true" Dense="true" Class="pa-0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>URN</MudTh>
                    <MudTh>Area</MudTh>
                    <MudTh>IsAssignable</MudTh>
                    <MudTh>IsDelegable</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudLink Href="@($"/package/{context.Id}")">@context.Name</MudLink>
                    </MudTd>
                    <MudTd DataLabel="URN">
                        <MudText Typo="Typo.caption" Class="mono">@(context.Urn ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Area">
                        <MudText Typo="Typo.body2">@(context.Area?.Name ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="IsAssignable">
                        <MudIcon Icon="@(context.IsAssignable ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                 Color="@(context.IsAssignable ? Color.Success : Color.Error)" Size="Size.Small" />
                    </MudTd>
                    <MudTd DataLabel="IsDelegable">
                        <MudIcon Icon="@(context.IsDelegable ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                 Color="@(context.IsDelegable ? Color.Success : Color.Error)" Size="Size.Small" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">No packages for this provider.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@($"Roles ({_data.Roles.Count})")"
                     Icon="@Icons.Material.Filled.Badge">
            <MudTable Items="_data.Roles" Hover="true" Dense="true" Class="pa-0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>URN</MudTh>
                    <MudTh>IsKeyRole</MudTh>
                    <MudTh>IsAssignable</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudLink Href="@($"/role/{context.Id}")">@context.Name</MudLink>
                    </MudTd>
                    <MudTd DataLabel="URN">
                        <MudText Typo="Typo.caption" Class="mono">@(context.Urn ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="IsKeyRole">
                        <MudIcon Icon="@(context.IsKeyRole ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                 Color="@(context.IsKeyRole ? Color.Success : Color.Error)" Size="Size.Small" />
                    </MudTd>
                    <MudTd DataLabel="IsAssignable">
                        <MudIcon Icon="@(context.IsAssignable ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                 Color="@(context.IsAssignable ? Color.Success : Color.Error)" Size="Size.Small" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">No roles for this provider.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

    </MudTabs>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ProviderDetailsData? _data;

    protected override Task OnParametersSetAsync() => RunAsync(LoadAsync);

    protected override Task OnEnvironmentChangedAsync() => RunAsync(LoadAsync);

    private async Task LoadAsync(CancellationToken ct) => _data = await DataService.GetAsync(EnvState.Current, Id, ct);
}
