@page "/tools/grant-check"
@using Altinn.AccessMgmt.FFB.Services
@using Altinn.AccessMgmt.PersistenceEF.Extensions
@using Dapper
@using Microsoft.EntityFrameworkCore
@inject IEnvironmentDbContextFactory DbFactory

<PageTitle>Grant Check</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Grant Check</MudText>
<MudText Typo="Typo.body1" Class="mb-6 mud-text-secondary">
    Går gjennom alle tabellene i DbContext-modellen for de valgte schemaene og sjekker at de valgte
    rollene har de valgte privilegiene på hver tabell, i hvert valgte miljø. Manglende grants kan fikses
    ved å kjøre <code>GRANT</code>-scriptet direkte.
</MudText>

@* ── Input panel ──────────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pa-4 mb-6">
    <MudGrid Spacing="3">
        <MudItem xs="12">
            <MudText Typo="Typo.body2" Class="mb-1 mud-text-secondary">Miljø:</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                @foreach (var env in DbFactory.Environments)
                {
                    var e = env;
                    var configured = DbFactory.IsConfigured(e);
                    <MudCheckBox @bind-Value="_envSelected[e]"
                                 Label="@e"
                                 Disabled="@(!configured)"
                                 Color="Color.Primary"
                                 Dense="true" />
                }
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudText Typo="Typo.body2" Class="mb-1 mud-text-secondary">Schema:</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                @foreach (var schema in _schemaSelected.Keys)
                {
                    var s = schema;
                    <MudCheckBox @bind-Value="_schemaSelected[s]" Label="@s" Color="Color.Primary" Dense="true" />
                }
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudText Typo="Typo.body2" Class="mb-1 mud-text-secondary">Roller:</MudText>
            <MudStack Wrap="Wrap.Wrap" Spacing="0">
                @foreach (var role in Roles)
                {
                    var r = role;
                    <MudCheckBox @bind-Value="_roleSelected[r]" Label="@r" Color="Color.Primary" Dense="true" />
                }
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudText Typo="Typo.body2" Class="mb-1 mud-text-secondary">Privilegier:</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                @foreach (var priv in AllPrivileges)
                {
                    var p = priv;
                    <MudCheckBox @bind-Value="_privilegeSelected[p]" Label="@p" Color="Color.Primary" Dense="true" />
                }
            </MudStack>
        </MudItem>

        <MudItem xs="12">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       Disabled="@(_running || !CanRun)"
                       OnClick="RunCheck">
                @(_running ? "Sjekker..." : "Kjør sjekk")
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_running)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@foreach (var (env, message) in _envErrors)
{
    <MudAlert Severity="Severity.Warning" Class="mb-2"><b>@env:</b> @message</MudAlert>
}

@if (_checkedAt is not null && _error is null && _environmentsChecked > 0)
{
    var unfixedCount = _missing.Count(r => !r.IsFixed);

    <MudStack Row="true" Spacing="2" Class="mb-4" AlignItems="AlignItems.Center">
        <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">@_okCount ok</MudChip>
        @if (unfixedCount > 0)
        {
            <MudChip T="string" Color="Color.Error" Icon="@Icons.Material.Filled.Error">@unfixedCount mangler grants</MudChip>
        }
        @if (_missingFromDb.Count > 0)
        {
            <MudChip T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">@_missingFromDb.Count i modell, ikke i DB</MudChip>
        }
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_checkedAt?.ToString("HH:mm:ss")</MudText>
        <MudSpacer />
        @if (_missing.Any(r => !r.IsFixed && r.Error is null))
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Build"
                       Disabled="_fixingAll"
                       OnClick="FixAll">
                @(_fixingAll ? "Fikser..." : "Fiks alle")
            </MudButton>
        }
    </MudStack>

    @if (unfixedCount == 0 && _missingFromDb.Count == 0)
    {
        <MudAlert Severity="Severity.Success">
            Alle @_okCount tabeller har korrekte grants for de valgte rollene.
        </MudAlert>
    }

    @foreach (var result in _missing)
    {
        <MudPaper Elevation="1" Class="mb-3">
            <MudExpansionPanel Dense="true">
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        @if (result.IsFixed)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                        }
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@result.Environment</MudChip>
                        <MudText Typo="Typo.subtitle1" Style="font-family:monospace">@($"{result.Schema}.{result.Table}")</MudText>
                        <MudSpacer />
                        @if (result.IsFixed)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check">Fikset</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">@result.Missing.Count mangler</MudChip>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Disabled="@result.IsFixing"
                                       OnClick="@(() => FixTable(result))">
                                @(result.IsFixing ? "..." : "Kjør GRANT")
                            </MudButton>
                        }
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <div class="pa-4">
                        @if (result.Missing.Count > 0)
                        {
                            <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="mb-2">Mangler:</MudText>
                            @foreach (var m in result.Missing)
                            {
                                <MudText Typo="Typo.body2" Style="font-family:monospace">@m.Role — @m.Privilege</MudText>
                            }
                        }
                        @if (result.Missing.Count > 0)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-2 mt-3">SQL som kjøres:</MudText>
                            <div style="background:var(--mud-palette-background-grey);border-radius:4px;padding:8px 10px">
                                @foreach (var stmt in GrantStatements(result))
                                {
                                    <MudText Typo="Typo.caption" Style="font-family:monospace;white-space:pre-wrap;user-select:text">@stmt</MudText>
                                }
                            </div>
                        }
                        @if (result.Error is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@result.Error</MudAlert>
                        }
                    </div>
                </ChildContent>
            </MudExpansionPanel>
        </MudPaper>
    }

    @if (_missingFromDb.Count > 0)
    {
        <MudPaper Elevation="0" Class="pa-4 mt-4" Style="border:1px solid var(--mud-palette-warning)">
            <MudText Typo="Typo.subtitle2" Color="Color.Warning" Class="mb-2">
                Tabeller i modellen som ikke finnes i DB (ikke sjekket for grants):
            </MudText>
            @foreach (var (env, schema, table) in _missingFromDb)
            {
                <MudText Typo="Typo.body2" Style="font-family:monospace">@($"[{env}] {schema}.{table}")</MudText>
            }
        </MudPaper>
    }
}

@code {
    // Shared with the migration SQL generator so the two never drift apart.
    private static readonly IReadOnlyList<string> Roles = TableGrantConstants.Roles;
    private static readonly IReadOnlyList<string> AllPrivileges = TableGrantConstants.Privileges;

    private readonly Dictionary<string, bool> _roleSelected = Roles.ToDictionary(r => r, _ => true);
    private readonly Dictionary<string, bool> _privilegeSelected = AllPrivileges.ToDictionary(p => p, _ => true);
    private Dictionary<string, bool> _envSelected = new(StringComparer.Ordinal);
    private Dictionary<string, bool> _schemaSelected = new(StringComparer.Ordinal);

    private bool _running;
    private bool _fixingAll;
    private DateTimeOffset? _checkedAt;
    private string? _error;
    private int _okCount;
    private int _environmentsChecked;
    private List<TableGrant> _missing = [];
    private List<(string Env, string Schema, string Table)> _missingFromDb = [];
    private List<(string Env, string Message)> _envErrors = [];

    // Roles/privileges captured at the time of the last check — used for the GRANT preview and fix so
    // they stay consistent even if the user toggles the checkboxes afterwards.
    private List<string> _checkedRoles = [];
    private List<string> _checkedPrivileges = [];

    private bool CanRun =>
        _envSelected.Values.Any(v => v) &&
        _schemaSelected.Values.Any(v => v) &&
        _roleSelected.Values.Any(v => v) &&
        _privilegeSelected.Values.Any(v => v);

    protected override void OnInitialized()
    {
        _envSelected = DbFactory.Environments.ToDictionary(e => e, _ => false, StringComparer.Ordinal);

        // Schema options come from the (environment-independent) EF model.
        var modelEnv = DbFactory.Environments.FirstOrDefault(DbFactory.IsConfigured);
        try
        {
            using var db = DbFactory.CreateContext(modelEnv!);
            var schemas = db.Model.GetEntityTypes()
                .Select(t => t.GetSchema())
                .Where(s => !string.IsNullOrEmpty(s))
                .Select(s => s!)
                .Distinct(StringComparer.Ordinal)
                .OrderBy(s => s, StringComparer.Ordinal)
                .ToList();

            _schemaSelected = schemas.ToDictionary(
                s => s,
                s => string.Equals(s, "dbo", StringComparison.OrdinalIgnoreCase),
                StringComparer.Ordinal);
        }
        catch
        {
            // No configured environment — fall back to the known schemas.
            _schemaSelected = new(StringComparer.Ordinal) { ["dbo"] = true, ["dbo_history"] = false };
        }
    }

    private async Task RunCheck()
    {
        _running = true;
        _error = null;
        _missing = [];
        _missingFromDb = [];
        _envErrors = [];
        _okCount = 0;
        _environmentsChecked = 0;
        _checkedAt = null;
        _checkedRoles = Roles.Where(r => _roleSelected[r]).ToList();
        _checkedPrivileges = AllPrivileges.Where(p => _privilegeSelected[p]).ToList();
        var envs = _envSelected.Where(kv => kv.Value).Select(kv => kv.Key).ToList();
        var schemas = _schemaSelected.Where(kv => kv.Value).Select(kv => kv.Key).ToList();
        StateHasChanged();

        try
        {
            var missing = new List<TableGrant>();
            var missingFromDb = new List<(string Env, string Schema, string Table)>();
            var envErrors = new List<(string Env, string Message)>();
            var okCount = 0;
            var checkedCount = 0;

            foreach (var env in envs)
            {
                try
                {
                    okCount += await CheckEnvironment(env, schemas, missing, missingFromDb);
                    checkedCount++;
                }
                catch (Exception ex)
                {
                    envErrors.Add((env, ex.Message));
                }
            }

            _missing = missing;
            _missingFromDb = missingFromDb;
            _envErrors = envErrors;
            _okCount = okCount;
            _environmentsChecked = checkedCount;
            _checkedAt = DateTimeOffset.Now;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }

    /// <summary>Checks one environment and appends its findings. Returns the number of OK tables.</summary>
    private async Task<int> CheckEnvironment(
        string env,
        List<string> schemas,
        List<TableGrant> missing,
        List<(string Env, string Schema, string Table)> missingFromDb)
    {
        using var db = DbFactory.CreateContext(env);
        var conn = db.Database.GetDbConnection();

        // has_table_privilege throws if a role does not exist — verify up front.
        var existingRoles = (await conn.QueryAsync<string>(
            "SELECT rolname FROM pg_roles WHERE rolname = ANY(@roles)", new { roles = _checkedRoles }))
            .ToHashSet(StringComparer.Ordinal);

        var missingRoles = _checkedRoles.Where(r => !existingRoles.Contains(r)).ToList();
        if (missingRoles.Count > 0)
        {
            throw new InvalidOperationException($"Rollene finnes ikke i databasen: {string.Join(", ", missingRoles)}.");
        }

        var okCount = 0;

        foreach (var schema in schemas)
        {
            var modelTables = db.Model.GetEntityTypes()
                .Where(t => string.Equals(t.GetSchema(), schema, StringComparison.OrdinalIgnoreCase))
                .Select(t => t.GetTableName())
                .Where(t => !string.IsNullOrEmpty(t))
                .Select(t => t!)
                .Distinct(StringComparer.Ordinal)
                .OrderBy(t => t, StringComparer.Ordinal)
                .ToList();

            if (modelTables.Count == 0)
            {
                continue;
            }

            // Only check tables that actually exist in the DB — model may be ahead of the environment.
            var dbTables = (await conn.QueryAsync<string>(
                "SELECT tablename FROM pg_tables WHERE schemaname = @schema", new { schema }))
                .ToHashSet(StringComparer.Ordinal);

            var toCheck = modelTables.Where(dbTables.Contains).ToList();
            missingFromDb.AddRange(modelTables.Where(t => !dbTables.Contains(t)).Select(t => (env, schema, t)));

            if (toCheck.Count == 0)
            {
                continue;
            }

            // Npgsql binds arrays natively, so pass tables/roles/privileges as parameters.
            const string sql = """
                SELECT t.tbl AS "Table", r.role AS "Role", p.priv AS "Privilege"
                FROM unnest(@tables::text[]) AS t(tbl)
                CROSS JOIN unnest(@roles::text[]) AS r(role)
                CROSS JOIN unnest(@privs::text[]) AS p(priv)
                WHERE NOT has_table_privilege(r.role, format('%I.%I', @schema, t.tbl), p.priv)
                ORDER BY t.tbl, r.role, p.priv
                """;

            var rows = (await conn.QueryAsync<GrantRow>(
                sql,
                new { tables = toCheck, roles = _checkedRoles, privs = _checkedPrivileges, schema })).ToList();
            var byTable = rows.GroupBy(r => r.Table, StringComparer.Ordinal)
                .ToDictionary(g => g.Key, g => g.Select(r => (r.Role, r.Privilege)).ToList(), StringComparer.Ordinal);

            missing.AddRange(toCheck
                .Where(byTable.ContainsKey)
                .Select(t => new TableGrant { Environment = env, Schema = schema, Table = t, Missing = byTable[t] }));
            okCount += toCheck.Count - byTable.Count;
        }

        return okCount;
    }

    private async Task FixTable(TableGrant result)
    {
        result.IsFixing = true;
        StateHasChanged();

        try
        {
            using var db = DbFactory.CreateContext(result.Environment);
            var conn = db.Database.GetDbConnection();
            foreach (var statement in GrantStatements(result))
            {
                await conn.ExecuteAsync(statement);
            }

            result.Missing = [];
            result.IsFixed = true;
            result.Error = null;
        }
        catch (Exception ex)
        {
            result.Error = ex.Message;
        }
        finally
        {
            result.IsFixing = false;
            StateHasChanged();
        }
    }

    private async Task FixAll()
    {
        _fixingAll = true;
        StateHasChanged();

        foreach (var result in _missing.Where(r => !r.IsFixed && r.Error is null).ToList())
        {
            await FixTable(result);
        }

        _fixingAll = false;
        StateHasChanged();
    }

    // ── Helpers ──────────────────────────────────────────────────────────────
    // One GRANT per role, listing only the privileges that were actually missing for that role.
    private static IEnumerable<string> GrantStatements(TableGrant result) =>
        result.Missing
            .GroupBy(m => m.Role, StringComparer.Ordinal)
            .Select(g => GrantSql(
                result.Schema,
                result.Table,
                g.Key,
                g.Select(m => m.Privilege).Distinct(StringComparer.Ordinal)));

    private static string GrantSql(string schema, string table, string role, IEnumerable<string> privileges) =>
        $"GRANT {string.Join(", ", privileges)} ON TABLE {Quote(schema)}.{Quote(table)} TO {Quote(role)};";

    private static string Quote(string identifier) =>
        $"\"{identifier.Replace("\"", "\"\"")}\"";

    // ── Models ────────────────────────────────────────────────────────────────
    private sealed class GrantRow
    {
        public string Table { get; set; } = "";

        public string Role { get; set; } = "";

        public string Privilege { get; set; } = "";
    }

    private sealed class TableGrant
    {
        public string Environment { get; set; } = "";

        public string Schema { get; set; } = "";

        public string Table { get; set; } = "";

        public List<(string Role, string Privilege)> Missing { get; set; } = [];

        public bool IsFixing { get; set; }

        public bool IsFixed { get; set; }

        public string? Error { get; set; }
    }
}
