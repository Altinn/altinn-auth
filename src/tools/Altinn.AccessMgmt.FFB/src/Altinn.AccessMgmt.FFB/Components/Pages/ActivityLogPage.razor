@page "/tools/activitylog"
@using Altinn.AccessMgmt.PersistenceEF.Constants
@using Altinn.AccessMgmt.PersistenceEF.Queries
@using Altinn.Authorization.Api.Contracts.AccessManagement.ActivityLog
@using Altinn.Authorization.Api.Contracts.AccessManagement.Request
@using PersistedActivityLog = Altinn.AccessMgmt.PersistenceEF.Models.ActivityLog
@inherits EnvironmentPageBase
@inject ActivityLogPageService PageService
@inject EntitySearchService SearchService

<PageTitle>Aktivitetslogg</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Aktivitetslogg</MudText>
<MudText Typo="Typo.body1" Class="mb-6 mud-text-secondary">
    Bla og filtrer i <code>dbo.activitylog</code> — hendelser for assignments, delegeringer og
    forespørsler, skrevet av databasetriggere. Nyeste først; ett filter per dimensjon, flere
    verdier innen hver, og spørringen kjører automatisk når filtrene endres.
</MudText>

@* ── Filter bar ────────────────────────────────────────────────────────────── *@
<MudPaper Elevation="1" Class="pa-3 mb-4">
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="4" AlignItems="AlignItems.Center">
        <div style="min-width: 320px;">
            <EntityLookupField Label="Party" Value="_partyId" ValueChanged="OnPartyChanged" />
        </div>
        <MudRadioGroup T="PartyDirection" Value="_direction" ValueChanged="OnDirectionChanged">
            <MudRadio T="PartyDirection" Value="PartyDirection.From" Dense="true">Gitt til andre</MudRadio>
            <MudRadio T="PartyDirection" Value="PartyDirection.To" Dense="true">Mottatt av andre</MudRadio>
            <MudRadio T="PartyDirection" Value="PartyDirection.Via" Dense="true">Fasilitert</MudRadio>
            <MudRadio T="PartyDirection" Value="PartyDirection.By" Dense="true">Utført av</MudRadio>
            <MudRadio T="PartyDirection" Value="PartyDirection.All" Dense="true">Alt</MudRadio>
        </MudRadioGroup>
    </MudStack>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
        Party ankrer loggen: retningen styrer hvilken side parten må stå på i hver hendelse.
        Filtrene under snevrer inn videre.
    </MudText>
    <MudDivider Class="mb-3" />

    @* ── Activity type catalog ─────────────────────────────────────────────── *@
    <MudText Typo="Typo.subtitle2" Class="mb-1">Hendelsestype</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
        Fra aktivitetstype-katalogen — hvert valg filtrerer på hele kombinasjonen av type,
        subtype, hendelse og status. Hold pekeren over et valg for beskrivelsen.
    </MudText>
    @foreach (var typeGroup in ActivityTypeConstants.AllEntities().GroupBy(d => d.Entity.Type).OrderBy(g => g.Key))
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center" Class="mb-1">
            <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="min-width: 90px;">@typeGroup.Key</MudText>
            @foreach (var definition in typeGroup)
            {
                var d = definition;
                <MudTooltip Text="@d.Entity.Description">
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="@(_selectedActivityTypes.Contains(d.Id) ? Variant.Filled : Variant.Outlined)"
                             Color="@(_selectedActivityTypes.Contains(d.Id) ? Color.Primary : Color.Default)"
                             OnClick="@(() => ToggleActivityType(d.Id))">
                        @d.Entity.Name
                    </MudChip>
                </MudTooltip>
            }
        </MudStack>
    }
    <MudDivider Class="my-3" />

    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center">

        @foreach (var dim in _active)
        {
            var d = dim;
            <MudChip T="string"
                     Color="Color.Primary"
                     Variant="@(d == _editing ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => ToggleEditor(d))"
                     OnClose="@(() => RemoveDimension(d))">
                @ChipLabel(d)
            </MudChip>
        }

        <MudMenu Label="@(_active.Count == 0 ? "Legg til filter" : "Legg til")"
                 StartIcon="@Icons.Material.Filled.Add"
                 Variant="Variant.Outlined"
                 Color="Color.Primary"
                 Dense="true">
            @foreach (var group in DimensionGroups)
            {
                if (group != DimensionGroups[0] && group.Any(Available))
                {
                    <MudDivider />
                }

                @foreach (var dim in group.Where(Available))
                {
                    var d = dim;
                    <MudMenuItem OnClick="@(() => AddDimension(d))">@DimensionLabel(d)</MudMenuItem>
                }
            }
        </MudMenu>

        @if (_active.Count > 0)
        {
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Close"
                       OnClick="ClearAll">
                Nullstill
            </MudButton>
        }

        <MudSpacer />

        <div style="width: 140px;">
            <MudNumericField T="int"
                             Value="_pageSize"
                             ValueChanged="OnPageSizeChanged"
                             Label="Sidestørrelse"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="10"
                             Max="5000" />
        </div>
    </MudStack>

    @* ── Value editor for the open chip ─────────────────────────────────────── *@
    @if (_editing is { } editing)
    {
        <MudDivider Class="my-3" />
        <MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle2">Velg @DimensionLabel(editing).ToLowerInvariant()</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               aria-label="Lukk"
                               OnClick="@(() => _editing = null)" />
            </MudStack>

            <MudText Typo="Typo.caption" Class="mud-text-secondary">@DimensionHint(editing)</MudText>

            @switch (editing)
            {
                case FilterDim.From:
                case FilterDim.To:
                case FilterDim.Via:
                case FilterDim.By:
                    <MudStack Spacing="2" Style="max-width: 560px;">
                        @FacetSearch(editing)
                        <EntityLookupField Label="Eller lim inn part (UUID)" @bind-Value="_entityDraft" />
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Disabled="@(_entityDraft is null)"
                                       OnClick="@(() => AddGuidValue(editing, _entityDraft))">
                                Legg til
                            </MudButton>
                        </MudStack>
                        @SelectedGuidChips(editing)
                    </MudStack>
                    break;

                case FilterDim.Date:
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Style="max-width: 480px;">
                        <MudDatePicker Label="Fra dato"
                                       Date="_afterDate"
                                       DateChanged="@(d => { _afterDate = d; ScheduleQuery(); })"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true" />
                        <MudDatePicker Label="Til dato"
                                       Date="_beforeDate"
                                       DateChanged="@(d => { _beforeDate = d; ScheduleQuery(); })"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true" />
                    </MudStack>
                    break;

                case FilterDim.Subtype:
                    @EnumCheckboxes(_subtypes)
                    break;

                case FilterDim.Trigger:
                    <MudStack Spacing="1">
                        @EnumCheckboxes(_triggers)
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                            Forespørselsstatus (kun Request-hendelser)
                        </MudText>
                        <div class="pl-4">
                            @EnumCheckboxes(_statuses)
                        </div>
                    </MudStack>
                    break;

                case FilterDim.Source:
                case FilterDim.Role:
                case FilterDim.Package:
                case FilterDim.Resource:
                    <MudStack Spacing="2" Style="max-width: 560px;">
                        @FacetSearch(editing)
                        @SelectedGuidChips(editing)
                    </MudStack>
                    break;

                case FilterDim.Instance:
                case FilterDim.Operation:
                    <MudStack Spacing="2" Style="max-width: 560px;">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudTextField @bind-Value="_textDraft"
                                          Label="@(editing == FilterDim.Instance ? "Instans-URN" : "Operasjons-id")"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          OnKeyDown="@(e => OnDraftKeyDown(e, editing))"
                                          Immediate="true"
                                          FullWidth="true" />
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Disabled="@string.IsNullOrWhiteSpace(_textDraft)"
                                       OnClick="@(() => AddTextValue(editing))">
                                Legg til
                            </MudButton>
                        </MudStack>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                            @foreach (var value in TextValues(editing))
                            {
                                var v = value;
                                <MudChip T="string"
                                         Size="Size.Small"
                                         OnClose="@(() => RemoveTextValue(editing, v))">
                                    @v
                                </MudChip>
                            }
                        </MudStack>
                    </MudStack>
                    break;

                case FilterDim.Item:
                case FilterDim.Parent:
                    <MudStack Spacing="2" Style="max-width: 560px;">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudTextField @bind-Value="_textDraft"
                                          Label="UUID"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Placeholder="Lim inn UUID..."
                                          OnKeyDown="@(e => OnDraftKeyDown(e, editing))"
                                          Immediate="true"
                                          FullWidth="true" />
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Disabled="@(!Guid.TryParse(_textDraft?.Trim(), out _))"
                                       OnClick="@(() => AddGuidDraft(editing))">
                                Legg til
                            </MudButton>
                        </MudStack>
                        @SelectedGuidChips(editing)
                    </MudStack>
                    break;
            }
        </MudStack>
    }
</MudPaper>

@if (!HasFilter && _items is null && !Loading)
{
    <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
        Legg til minst ett avgrensende filter — part, «Utført av», dato, operasjon eller
        item-/parent-id — så kjører spørringen automatisk.
    </MudText>
}

@* ── Status ────────────────────────────────────────────────────────────────── *@
@if (Loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}

@if (Error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@Error</MudAlert>
}

@* ── Results ───────────────────────────────────────────────────────────────── *@
@if (_items is not null)
{
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="3" Class="mb-2">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @(_hasMore ? $"Mer enn {_items.Count} hendelser" : $"{_items.Count} hendelser")
        </MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Gruppering</MudText>
        <MudRadioGroup T="GroupMode" Value="_grouping" ValueChanged="@(m => _grouping = m)">
            <MudRadio T="GroupMode" Value="GroupMode.None" Dense="true">Ingen</MudRadio>
            <MudRadio T="GroupMode" Value="GroupMode.Operation" Dense="true">Operasjon</MudRadio>
            <MudRadio T="GroupMode" Value="GroupMode.Parent" Dense="true">Parent</MudRadio>
        </MudRadioGroup>
    </MudStack>

    @if (_grouping != GroupMode.None)
    {
        @foreach (var group in GroupedItems())
        {
            <MudPaper Elevation="1" Class="mb-3">
                <MudText Typo="Typo.subtitle2" Class="pa-3 pb-1">@group.Header</MudText>
                @ResultsGrid(group.Items, false)
            </MudPaper>
        }
    }
    else
    {
        @ResultsGrid(_items, true)
    }

    @if (_hasMore)
    {
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Class="mt-3"
                   StartIcon="@Icons.Material.Filled.ExpandMore"
                   Disabled="@Loading"
                   OnClick="LoadMore">
            Hent flere
        </MudButton>
    }
}

@code {
    // ── Filter dimensions ─────────────────────────────────────────────────────

    private enum FilterDim
    {
        From,
        To,
        Via,
        By,
        Date,
        Subtype,
        Trigger,
        Source,
        Role,
        Package,
        Resource,
        Instance,
        Operation,
        Item,
        Parent,
    }

    private static readonly FilterDim[][] DimensionGroups =
    [
        [FilterDim.From, FilterDim.To, FilterDim.Via, FilterDim.By],
        [FilterDim.Date],
        [FilterDim.Subtype, FilterDim.Trigger, FilterDim.Source],
        [FilterDim.Role, FilterDim.Package, FilterDim.Resource, FilterDim.Instance],
        [FilterDim.Operation, FilterDim.Item, FilterDim.Parent],
    ];

    private static string DimensionLabel(FilterDim dim) => dim switch
    {
        FilterDim.From => "Fra",
        FilterDim.To => "Til",
        FilterDim.Via => "Via (fasilitator)",
        FilterDim.By => "Utført av",
        FilterDim.Date => "Dato",
        FilterDim.Subtype => "Subtype",
        FilterDim.Trigger => "Hendelse",
        FilterDim.Source => "Kilde",
        FilterDim.Role => "Rolle",
        FilterDim.Package => "Pakke",
        FilterDim.Resource => "Ressurs",
        FilterDim.Instance => "Instans",
        FilterDim.Operation => "Operasjon",
        FilterDim.Item => "ItemId",
        FilterDim.Parent => "ParentId",
        _ => dim.ToString(),
    };

    private static string PluralLabel(FilterDim dim) => dim switch
    {
        FilterDim.From or FilterDim.To or FilterDim.Via => "parter",
        FilterDim.By => "utførere",
        FilterDim.Subtype => "subtyper",
        FilterDim.Trigger => "hendelser",
        FilterDim.Source => "kilder",
        FilterDim.Role => "roller",
        FilterDim.Package => "pakker",
        FilterDim.Resource => "ressurser",
        FilterDim.Instance => "instanser",
        FilterDim.Operation => "operasjoner",
        FilterDim.Item => "item-id-er",
        FilterDim.Parent => "parent-id-er",
        _ => "valgt",
    };

    private static string DimensionHint(FilterDim dim) => dim switch
    {
        FilterDim.From => "Parten tilgangen er gitt fra (avgiver).",
        FilterDim.To => "Parten tilgangen er gitt til (rettighetshaver/mottaker).",
        FilterDim.Via => "Fasilitatoren delegeringen går via (f.eks. regnskapsfører).",
        FilterDim.By => "Entiteten som utførte endringen — person, systembruker eller internt system.",
        FilterDim.Date => "Avgrenser på hendelsestidspunktet (fra og med / til og med valgt dag).",
        FilterDim.Subtype => "Undertype på tvers av hovedtypene — Package matcher f.eks. både Assignment-, Delegation- og RequestPackage.",
        FilterDim.Trigger => "Hva som skjedde. Status settes på Request-hendelser: initialstatus ved Created, ny status ved Updated, siste status ved Deleted.",
        FilterDim.Source => "Systemet/kanalen endringen kom gjennom.",
        FilterDim.Role => "Hendelser der tilgangen gjelder valgt(e) rolle(r).",
        FilterDim.Package => "Hendelser som gjelder valgt(e) tilgangspakke(r).",
        FilterDim.Resource => "Hendelser som gjelder valgt(e) ressurs(er).",
        FilterDim.Instance => "Instans-URN, f.eks. urn:altinn:instance-id:… .",
        FilterDim.Operation => "Alle hendelser skrevet av samme operasjon (trace-id) — én brukerhandling.",
        FilterDim.Item => "Rad-id-en til det berørte objektet (teknisk).",
        FilterDim.Parent => "Hovedradens id, f.eks. AssignmentId for en pakkehendelse.",
        _ => string.Empty,
    };

    // ── Filter state ──────────────────────────────────────────────────────────

    private readonly List<FilterDim> _active = [];
    private FilterDim? _editing;

    // ── Party anchor ──────────────────────────────────────────────────────────

    private enum PartyDirection
    {
        All,
        From,
        To,
        Via,
        By,
    }

    private Guid? _partyId;
    private PartyDirection _direction = PartyDirection.All;

    private void OnPartyChanged(Guid? value)
    {
        _partyId = value;
        if (value is { } id)
        {
            _ = ResolveEntityNameAsync(id);
        }

        PurgeAnchoredDimension();
        ScheduleQuery();
    }

    private void OnDirectionChanged(PartyDirection value)
    {
        _direction = value;
        PurgeAnchoredDimension();
        ScheduleQuery();
    }

    private void PurgeAnchoredDimension()
    {
        if (_partyId.HasValue && AnchoredDim() is { } dim && _active.Contains(dim))
        {
            RemoveDimension(dim);
        }
    }

    private FilterDim? AnchoredDim() => _direction switch
    {
        PartyDirection.From => FilterDim.From,
        PartyDirection.To => FilterDim.To,
        PartyDirection.Via => FilterDim.Via,
        PartyDirection.By => FilterDim.By,
        _ => null,
    };

    private IReadOnlyCollection<Guid>? AnchoredOrList(FilterDim dim, PartyDirection direction, FilterDim? excludeDim = null) =>
        _partyId is { } party && _direction == direction ? [party] : (dim == excludeDim ? null : ListOrNull(dim));

    private readonly Dictionary<FilterDim, List<Guid>> _guidValues = [];
    private readonly Dictionary<FilterDim, List<string>> _textValues = [];
    private readonly Dictionary<Guid, string> _names = [];

    private Guid? _entityDraft;
    private string? _textDraft;
    private string? _facetTerm;
    private bool _facetLoading;
    private bool _facetHasMore;
    private List<ActivityLogFacet>? _facetResults;

    private DateTime? _afterDate;
    private DateTime? _beforeDate;
    private int _pageSize = 200;

    private readonly HashSet<Guid> _selectedActivityTypes = [];

    private readonly Dictionary<ActivityLogSubtype, bool> _subtypes =
        Enum.GetValues<ActivityLogSubtype>().ToDictionary(v => v, _ => false);

    private readonly Dictionary<ActivityLogTrigger, bool> _triggers =
        Enum.GetValues<ActivityLogTrigger>().ToDictionary(v => v, _ => false);

    private readonly Dictionary<RequestStatus, bool> _statuses =
        Enum.GetValues<RequestStatus>().Where(s => s != RequestStatus.None).ToDictionary(v => v, _ => false);

    // ── Data ──────────────────────────────────────────────────────────────────

    private List<PersistedActivityLog>? _items;
    private int _pageNo;
    private bool _hasMore;
    private CancellationTokenSource? _debounce;

    protected override Task OnEnvironmentChangedAsync()
    {
        _items = null;
        _pageNo = 0;
        _hasMore = false;
        _facetResults = null;
        _facetHasMore = false;
        _names.Clear();
        Error = null;
        return Task.CompletedTask;
    }

    // ── Chip bar ──────────────────────────────────────────────────────────────

    private bool Available(FilterDim dim) =>
        !_active.Contains(dim) && !(_partyId.HasValue && dim == AnchoredDim());

    private void AddDimension(FilterDim dim)
    {
        _active.Add(dim);
        OpenEditor(dim);
    }

    private void ToggleEditor(FilterDim dim)
    {
        if (_editing == dim)
        {
            _editing = null;
        }
        else
        {
            OpenEditor(dim);
        }
    }

    private void OpenEditor(FilterDim dim)
    {
        _editing = dim;
        _entityDraft = null;
        _textDraft = null;
        _facetTerm = null;
        _facetResults = null;
        _facetHasMore = false;
    }

    private void RemoveDimension(FilterDim dim)
    {
        _active.Remove(dim);
        if (_editing == dim)
        {
            _editing = null;
        }

        switch (dim)
        {
            case FilterDim.Date:
                _afterDate = null;
                _beforeDate = null;
                break;
            case FilterDim.Subtype:
                ResetEnum(_subtypes);
                break;
            case FilterDim.Trigger:
                ResetEnum(_triggers);
                ResetEnum(_statuses);
                break;
            case FilterDim.Instance:
            case FilterDim.Operation:
                _textValues.Remove(dim);
                break;
            default:
                _guidValues.Remove(dim);
                break;
        }

        ScheduleQuery();
    }

    private void ClearAll()
    {
        _active.Clear();
        _editing = null;
        _guidValues.Clear();
        _textValues.Clear();
        _afterDate = null;
        _beforeDate = null;
        _selectedActivityTypes.Clear();
        ResetEnum(_subtypes);
        ResetEnum(_triggers);
        ResetEnum(_statuses);
        _debounce?.Cancel();
        _items = null;
        _pageNo = 0;
        _hasMore = false;
    }

    private static void ResetEnum<T>(Dictionary<T, bool> values)
        where T : notnull
    {
        foreach (var key in values.Keys.ToList())
        {
            values[key] = false;
        }
    }

    private string ChipLabel(FilterDim dim)
    {
        switch (dim)
        {
            case FilterDim.Date:
                return (_afterDate, _beforeDate) switch
                {
                    (not null, not null) => $"{_afterDate:dd.MM.yy}–{_beforeDate:dd.MM.yy}",
                    (not null, null) => $"Fra {_afterDate:dd.MM.yy}",
                    (null, not null) => $"Til {_beforeDate:dd.MM.yy}",
                    _ => DimensionLabel(dim),
                };
            case FilterDim.Subtype:
                return EnumChipLabel(dim, _subtypes);
            case FilterDim.Trigger:
            {
                var triggers = _triggers.Where(kv => kv.Value).Select(kv => kv.Key.ToString()).ToList();
                var statuses = _statuses.Where(kv => kv.Value).Select(kv => kv.Key.ToString()).ToList();
                var parts = new List<string>();
                if (triggers.Count == 1)
                {
                    parts.Add(triggers[0]);
                }
                else if (triggers.Count > 1)
                {
                    parts.Add($"{triggers.Count} hendelser");
                }

                if (statuses.Count == 1)
                {
                    parts.Add(statuses[0]);
                }
                else if (statuses.Count > 1)
                {
                    parts.Add($"{statuses.Count} statuser");
                }

                return parts.Count > 0 ? string.Join(" · ", parts) : DimensionLabel(dim);
            }
            case FilterDim.Instance:
            case FilterDim.Operation:
                var texts = TextValues(dim);
                return texts.Count switch
                {
                    0 => DimensionLabel(dim),
                    1 => Shorten(texts[0]),
                    _ => $"{texts.Count} {PluralLabel(dim)}",
                };
            default:
                var ids = GuidValues(dim);
                return ids.Count switch
                {
                    0 => DimensionLabel(dim),
                    1 => NameOrShortId(ids[0]),
                    _ => $"{ids.Count} {PluralLabel(dim)}",
                };
        }
    }

    private string EnumChipLabel<T>(FilterDim dim, Dictionary<T, bool> values)
        where T : notnull
    {
        var selected = values.Where(kv => kv.Value).Select(kv => kv.Key.ToString()).ToList();
        return selected.Count switch
        {
            0 => DimensionLabel(dim),
            1 => selected[0]!,
            _ => $"{selected.Count} {PluralLabel(dim)}",
        };
    }

    private string NameOrShortId(Guid id) =>
        _names.TryGetValue(id, out var name) ? name : id.ToString()[..8];

    private static string Shorten(string value) =>
        value.Length <= 24 ? value : value[..21] + "...";

    // ── Value editing ─────────────────────────────────────────────────────────

    private List<Guid> GuidValues(FilterDim dim)
    {
        if (!_guidValues.TryGetValue(dim, out var list))
        {
            list = [];
            _guidValues[dim] = list;
        }

        return list;
    }

    private List<string> TextValues(FilterDim dim)
    {
        if (!_textValues.TryGetValue(dim, out var list))
        {
            list = [];
            _textValues[dim] = list;
        }

        return list;
    }

    private void AddGuidValue(FilterDim dim, Guid? id)
    {
        if (id is not { } value)
        {
            return;
        }

        var list = GuidValues(dim);
        if (!list.Contains(value))
        {
            list.Add(value);
            _ = ResolveEntityNameAsync(value);
            ScheduleQuery();
        }

        _entityDraft = null;
    }

    private void AddGuidDraft(FilterDim dim)
    {
        if (Guid.TryParse(_textDraft?.Trim(), out var id))
        {
            var list = GuidValues(dim);
            if (!list.Contains(id))
            {
                list.Add(id);
                ScheduleQuery();
            }

            _textDraft = null;
        }
    }

    private void RemoveGuidValue(FilterDim dim, Guid id)
    {
        GuidValues(dim).Remove(id);
        ScheduleQuery();
    }

    private void AddTextValue(FilterDim dim)
    {
        var value = _textDraft?.Trim();
        if (string.IsNullOrEmpty(value))
        {
            return;
        }

        var list = TextValues(dim);
        if (!list.Contains(value))
        {
            list.Add(value);
            ScheduleQuery();
        }

        _textDraft = null;
    }

    private void RemoveTextValue(FilterDim dim, string value)
    {
        TextValues(dim).Remove(value);
        ScheduleQuery();
    }

    private void OnDraftKeyDown(KeyboardEventArgs e, FilterDim dim)
    {
        if (e.Key != "Enter")
        {
            return;
        }

        if (dim is FilterDim.Item or FilterDim.Parent)
        {
            AddGuidDraft(dim);
        }
        else
        {
            AddTextValue(dim);
        }
    }

    private void ToggleActivityType(Guid id)
    {
        if (!_selectedActivityTypes.Add(id))
        {
            _selectedActivityTypes.Remove(id);
        }

        ScheduleQuery();
    }

    private IReadOnlyCollection<ActivityTypeKey>? SelectedActivityTypeKeys()
    {
        if (_selectedActivityTypes.Count == 0)
        {
            return null;
        }

        var keys = new List<ActivityTypeKey>(_selectedActivityTypes.Count);
        foreach (var id in _selectedActivityTypes)
        {
            if (ActivityTypeConstants.TryGetById(id, out var definition))
            {
                keys.Add(new ActivityTypeKey(definition.Entity.Type, definition.Entity.Subtype, definition.Entity.Trigger, definition.Entity.Status));
            }
        }

        return keys;
    }

    private void AddFacetValue(FilterDim dim, ActivityLogFacet facet)
    {
        var list = GuidValues(dim);
        if (!list.Contains(facet.Id))
        {
            list.Add(facet.Id);
            if (facet.Name is not null)
            {
                _names[facet.Id] = facet.Name;
            }

            ScheduleQuery();
        }
    }

    private const int FacetPageSize = 20;

    private RenderFragment FacetSearch(FilterDim dim) => __builder =>
    {
        @if (!HasFilter)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Legg til et avgrensende filter først (party, part, dato, operasjon eller id) —
                da kan du søke blant verdier som faktisk forekommer i loggen.
            </MudText>
        }
        else
        {
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_facetTerm"
                              Label="Søk i forekommende verdier"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Placeholder="Tomt søk viser alle, alfabetisk..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyDown="OnFacetKeyDown"
                              Immediate="false"
                              FullWidth="true" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@_facetLoading"
                           OnClick="SearchFacetAsync">
                    Søk
                </MudButton>
            </MudStack>
            @if (_facetResults is not null)
            {
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    @foreach (var hit in _facetResults.Where(r => !GuidValues(dim).Contains(r.Id)))
                    {
                        var facet = hit;
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined"
                                 OnClick="@(() => AddFacetValue(dim, facet))">
                            @(facet.Name ?? facet.Id.ToString()[..8])
                        </MudChip>
                    }
                </MudStack>
                @if (_facetHasMore)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Flere treff finnes — søk smalere.</MudText>
                }
            }
        }
    };

    private RenderFragment SelectedGuidChips(FilterDim dim) => __builder =>
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
            @foreach (var id in GuidValues(dim))
            {
                var v = id;
                <MudChip T="string"
                         Size="Size.Small"
                         OnClose="@(() => RemoveGuidValue(dim, v))">
                    @NameOrShortId(v)
                </MudChip>
            }
        </MudStack>
    };

    private RenderFragment EnumCheckboxes<T>(Dictionary<T, bool> values)
        where T : notnull => __builder =>
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            @foreach (var key in values.Keys.ToList())
            {
                var k = key;
                <MudCheckBox T="bool"
                             Value="@values[k]"
                             ValueChanged="@(on => { values[k] = on; ScheduleQuery(); })"
                             Label="@k.ToString()"
                             Color="Color.Primary"
                             Dense="true" />
            }
        </MudStack>
    };

    // ── Catalog search (roles, packages, resources) ───────────────────────────

    private Task OnFacetKeyDown(KeyboardEventArgs e) =>
        e.Key == "Enter" ? SearchFacetAsync() : Task.CompletedTask;

    private async Task SearchFacetAsync()
    {
        if (_editing is not { } dim || FacetFieldFor(dim) is not { } field || !HasFilter)
        {
            return;
        }

        _facetLoading = true;
        try
        {
            var page = await PageService.FacetAsync(EnvState.Current, field, BuildFilter(excludeDim: dim), _facetTerm, FacetPageSize);
            _facetResults = [.. page.Items];
            _facetHasMore = page.HasMore;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            _facetLoading = false;
        }
    }

    private static ActivityLogFacetField? FacetFieldFor(FilterDim dim) => dim switch
    {
        FilterDim.From => ActivityLogFacetField.From,
        FilterDim.To => ActivityLogFacetField.To,
        FilterDim.Via => ActivityLogFacetField.Via,
        FilterDim.By => ActivityLogFacetField.By,
        FilterDim.Role => ActivityLogFacetField.Role,
        FilterDim.Package => ActivityLogFacetField.Package,
        FilterDim.Resource => ActivityLogFacetField.Resource,
        FilterDim.Source => ActivityLogFacetField.Source,
        _ => null,
    };

    private async Task ResolveEntityNameAsync(Guid id)
    {
        if (_names.ContainsKey(id))
        {
            return;
        }

        try
        {
            var hits = await SearchService.SearchAsync(
                EnvState.Current, id.ToString(), includeDeleted: true, EntitySearchKind.Uuid, maxResults: 1);

            if (hits.FirstOrDefault() is { } entity)
            {
                _names[id] = entity.Name;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // Name lookup is a convenience; an unreachable environment must not break the filter.
        }
    }

    // ── Query ─────────────────────────────────────────────────────────────────

    private bool HasFilter =>
        _partyId.HasValue ||
        GuidValues(FilterDim.From).Count > 0 ||
        GuidValues(FilterDim.To).Count > 0 ||
        GuidValues(FilterDim.Via).Count > 0 ||
        GuidValues(FilterDim.By).Count > 0 ||
        GuidValues(FilterDim.Item).Count > 0 ||
        GuidValues(FilterDim.Parent).Count > 0 ||
        TextValues(FilterDim.Operation).Count > 0 ||
        _afterDate.HasValue || _beforeDate.HasValue;

    private void OnPageSizeChanged(int value)
    {
        _pageSize = value;
        ScheduleQuery();
    }

    private void ScheduleQuery()
    {
        _debounce?.Cancel();
        var cts = _debounce = new CancellationTokenSource();
        _ = DebouncedRunAsync(cts.Token);
    }

    private async Task DebouncedRunAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(400, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (!HasFilter)
        {
            _items = null;
            _pageNo = 0;
            _hasMore = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await InvokeAsync(RunQuery);
    }

    private async Task RunQuery()
    {
        _items = null;
        _pageNo = 0;
        _hasMore = false;
        await FetchPage();
    }

    private Task LoadMore()
    {
        _pageNo++;
        return FetchPage();
    }

    private Task FetchPage() => RunAsync(async ct =>
    {
        var page = await PageService.QueryAsync(EnvState.Current, BuildFilter(), _pageSize, _pageNo, ct);

        _items = [.. _items ?? [], .. page.Items];
        _hasMore = page.HasMore;
    });

    private ActivityLogQueryFilter BuildFilter(FilterDim? excludeDim = null) => new()
    {
        AnyPartyIds = _partyId is { } party && _direction == PartyDirection.All ? [party] : null,
        FromIds = AnchoredOrList(FilterDim.From, PartyDirection.From, excludeDim),
        ToIds = AnchoredOrList(FilterDim.To, PartyDirection.To, excludeDim),
        ViaIds = AnchoredOrList(FilterDim.Via, PartyDirection.Via, excludeDim),
        ByIds = AnchoredOrList(FilterDim.By, PartyDirection.By, excludeDim),
        SourceIds = excludeDim == FilterDim.Source ? null : ListOrNull(FilterDim.Source),
        RoleIds = excludeDim == FilterDim.Role ? null : ListOrNull(FilterDim.Role),
        PackageIds = excludeDim == FilterDim.Package ? null : ListOrNull(FilterDim.Package),
        ResourceIds = excludeDim == FilterDim.Resource ? null : ListOrNull(FilterDim.Resource),
        ItemIds = ListOrNull(FilterDim.Item),
        ParentIds = ListOrNull(FilterDim.Parent),
        InstanceIds = TextListOrNull(FilterDim.Instance),
        OperationIds = TextListOrNull(FilterDim.Operation),
        ActivityTypeKeys = SelectedActivityTypeKeys(),
        Subtypes = Checked(_subtypes),
        Triggers = Checked(_triggers),
        Statuses = Checked(_statuses),
        After = _afterDate is not null ? new DateTimeOffset(_afterDate.Value.Date, TimeSpan.Zero) : null,
        Before = _beforeDate is not null ? new DateTimeOffset(_beforeDate.Value.Date.AddDays(1), TimeSpan.Zero) : null,
    };

    private IReadOnlyCollection<Guid>? ListOrNull(FilterDim dim)
    {
        var list = GuidValues(dim);
        return list.Count > 0 ? list : null;
    }

    private IReadOnlyCollection<string>? TextListOrNull(FilterDim dim)
    {
        var list = TextValues(dim);
        return list.Count > 0 ? list : null;
    }

    private static IReadOnlyCollection<T>? Checked<T>(Dictionary<T, bool> values)
        where T : notnull
    {
        var selected = values.Where(kv => kv.Value).Select(kv => kv.Key).ToList();
        return selected.Count > 0 ? selected : null;
    }

    // ── Grouping and results ──────────────────────────────────────────────────

    private enum GroupMode
    {
        None,
        Operation,
        Parent,
    }

    private GroupMode _grouping;

    private IEnumerable<(string Header, List<PersistedActivityLog> Items)> GroupedItems()
    {
        if (_items is null)
        {
            yield break;
        }

        var groups = _grouping == GroupMode.Operation
            ? _items.GroupBy(t => t.OperationId ?? t.ItemId.ToString())
            : _items.GroupBy(t => (t.ParentId ?? t.ItemId).ToString());

        foreach (var group in groups.OrderByDescending(g => g.Max(t => t.When)))
        {
            var items = group.OrderByDescending(t => t.When).ThenByDescending(t => t.Id).ToList();
            var header = _grouping == GroupMode.Operation
                ? $"Operasjon {Shorten(group.Key)} — {items.Count} hendelser — {items[0].When.ToLocalTime():yyyy-MM-dd HH:mm}"
                : ParentHeader(group.Key, items);
            yield return (header, items);
        }
    }

    private static string ParentHeader(string key, List<PersistedActivityLog> items)
    {
        var main = items.FirstOrDefault(t => t.ParentId is null) ?? items[0];
        var parties = main.FromName is not null || main.ToName is not null
            ? $"{main.FromName ?? "?"} → {main.ToName ?? "?"} — "
            : string.Empty;
        return $"{main.Type} — {parties}{items.Count} hendelser ({key[..8]})";
    }

    private void FilterOnOperation(string operationId)
    {
        if (!_active.Contains(FilterDim.Operation))
        {
            _active.Add(FilterDim.Operation);
        }

        var list = TextValues(FilterDim.Operation);
        if (!list.Contains(operationId))
        {
            list.Add(operationId);
            ScheduleQuery();
        }
    }

    private void FilterOnParent(Guid parentId)
    {
        if (!_active.Contains(FilterDim.Parent))
        {
            _active.Add(FilterDim.Parent);
        }

        var list = GuidValues(FilterDim.Parent);
        if (!list.Contains(parentId))
        {
            list.Add(parentId);
            ScheduleQuery();
        }
    }

    private RenderFragment ResultsGrid(IReadOnlyList<PersistedActivityLog> items, bool fixedHeight) => __builder =>
    {
        <MudDataGrid T="PersistedActivityLog"
                     Items="items"
                     Dense="true"
                     Hover="true"
                     Striped="true"
                     FixedHeader="@fixedHeight"
                     Height="@(fixedHeight ? "620px" : null)"
                     SortMode="SortMode.None">
            <Columns>

                <HierarchyColumn T="PersistedActivityLog" />

                <TemplateColumn Title="Når">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@context.Item.When.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Hendelse">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@TriggerColor(context.Item.Trigger)">
                            @context.Item.Trigger
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Type">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@TypeColor(context.Item.Type)" Variant="Variant.Outlined">
                            @context.Item.Type@(context.Item.Subtype is not null ? $"/{context.Item.Subtype}" : string.Empty)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Fra">
                    <CellTemplate>
                        @if (context.Item.FromId is not null)
                        {
                            <MudLink Href="@($"/entity/{context.Item.FromId}")" Typo="Typo.body2">
                                @(context.Item.FromName ?? context.Item.FromId.ToString())
                            </MudLink>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Til">
                    <CellTemplate>
                        @if (context.Item.ToId is not null)
                        {
                            <MudLink Href="@($"/entity/{context.Item.ToId}")" Typo="Typo.body2">
                                @(context.Item.ToName ?? context.Item.ToId.ToString())
                            </MudLink>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Via">
                    <CellTemplate>
                        @if (context.Item.ViaId is not null)
                        {
                            <MudText Typo="Typo.body2">@(context.Item.ViaName ?? context.Item.ViaId.ToString())</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Rolle">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@context.Item.RoleName</MudText>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Objekt">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@ObjectLabel(context.Item)</MudText>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Status">
                    <CellTemplate>
                        @if (context.Item.Status is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                @context.Item.Status
                            </MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Utført av">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@(context.Item.ByName ?? context.Item.ById?.ToString())</MudText>
                    </CellTemplate>
                </TemplateColumn>

            </Columns>

            <ChildRowContent>
                <MudPaper Elevation="0" Class="pa-3 mud-background-gray">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Kilde: @SourceLabel(context.Item.SourceId) — Operasjon:
                            @if (context.Item.OperationId is not null)
                            {
                                <MudLink Typo="Typo.caption"
                                         OnClick="@(() => FilterOnOperation(context.Item.OperationId))">
                                    @context.Item.OperationId
                                </MudLink>
                            }
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            ItemId: @context.Item.ItemId
                            @if (context.Item.ParentId is not null)
                            {
                                <text> — ParentId: </text>
                                <MudLink Typo="Typo.caption"
                                         OnClick="@(() => FilterOnParent(context.Item.ParentId.Value))">
                                    @context.Item.ParentId
                                </MudLink>
                            }
                        </MudText>
                        @if (context.Item.ViaRoleName is not null)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Via-rolle: @context.Item.ViaRoleName
                            </MudText>
                        }
                        @if (context.Item.Details is not null)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Detaljer: <code>@context.Item.Details</code>
                            </MudText>
                        }
                    </MudStack>
                </MudPaper>
            </ChildRowContent>

        </MudDataGrid>
    };

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static string ObjectLabel(PersistedActivityLog item) =>
        item.PackageName
        ?? item.ResourceName
        ?? item.InstanceId
        ?? (item.PackageId?.ToString() ?? item.ResourceId?.ToString())
        ?? string.Empty;

    private static string SourceLabel(Guid? sourceId) =>
        sourceId.HasValue && SystemEntityConstants.TryGetById(sourceId.Value, out var definition)
            ? definition.Entity.Name
            : sourceId?.ToString() ?? "ukjent";

    private static Color TriggerColor(ActivityLogTrigger trigger) => trigger switch
    {
        ActivityLogTrigger.Created => Color.Success,
        ActivityLogTrigger.Updated => Color.Warning,
        ActivityLogTrigger.Deleted => Color.Error,
        _ => Color.Default
    };

    private static Color TypeColor(ActivityLogType type) => type switch
    {
        ActivityLogType.Assignment => Color.Primary,
        ActivityLogType.Delegation => Color.Info,
        ActivityLogType.Request => Color.Secondary,
        _ => Color.Default
    };
}
