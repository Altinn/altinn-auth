@page "/assignment/{Id:guid}"
@inherits EnvironmentPageBase
@inject AssignmentDetailsService DataService

<PageTitle>Assignment – @Id</PageTitle>

@if (Loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (Error is not null)
{
    <MudAlert Severity="Severity.Error">@Error</MudAlert>
}
else if (_data is null)
{
    <MudAlert Severity="Severity.Error">Assignment not found: @Id</MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-6">
        <BackButton FallbackHref="@($"/entity/{_data.Assignment.FromId}")" />
        <MudText Typo="Typo.h4">Assignment</MudText>
        <MudChip T="string" Color="Color.Primary" Size="Size.Small">
            @(_data.Assignment.Role?.Name ?? _data.Assignment.RoleId.ToString())
        </MudChip>
    </MudStack>

    <MudGrid>
        <MudItem xs="12" md="6">
            <SummaryCard>
                <SummaryRow Label="Id" Monospace="true">@_data.Assignment.Id</SummaryRow>
                <SummaryRow Label="Role">
                    <MudLink Href="@($"/role/{_data.Assignment.RoleId}")">
                        @(_data.Assignment.Role?.Name ?? _data.Assignment.RoleId.ToString())
                    </MudLink>
                </SummaryRow>
                <SummaryRow Label="Role URN" Monospace="true">@(_data.Assignment.Role?.Urn ?? "–")</SummaryRow>
                <SummaryRow Label="From">
                    <MudLink Href="@($"/entity/{_data.Assignment.FromId}")">
                        @(_data.Assignment.From?.Name ?? _data.Assignment.FromId.ToString())
                    </MudLink>
                </SummaryRow>
                <SummaryRow Label="To">
                    <MudLink Href="@($"/entity/{_data.Assignment.ToId}")">
                        @(_data.Assignment.To?.Name ?? _data.Assignment.ToId.ToString())
                    </MudLink>
                </SummaryRow>
                <SummaryRow Label="ValidFrom">@_data.Assignment.Audit_ValidFrom.ToString("u")</SummaryRow>
                <SummaryRow Label="ChangedBy" Monospace="true">@(_data.Assignment.Audit_ChangedBy?.ToString() ?? "–")</SummaryRow>
                <SummaryRow Label="ChangeOperation" Monospace="true">@(_data.Assignment.Audit_ChangeOperation ?? "–")</SummaryRow>
            </SummaryCard>
        </MudItem>
    </MudGrid>

    @* ── Direct: explicitly stored on this assignment ── *@
    <MudText Typo="Typo.h5" Class="mt-8 mb-1">Direct</MudText>
    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
        Resources, packages and instances directly associated with this assignment.
    </MudText>
    <MudTabs Elevation="1" Rounded="false" ApplyEffectsToContainer="true">

        <MudTabPanel Text="@($"Resources ({_data.Resources.Count})")"
                     Icon="@Icons.Material.Filled.Api">
            <MudTable Items="_data.Resources" Hover="true" Dense="true" Class="pa-0">
                <HeaderContent>
                    <MudTh>Resource</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>RefId</MudTh>
                    <MudTh>PolicyPath</MudTh>
                    <MudTh>PolicyVersion</MudTh>
                    <MudTh>DelegationChangeId</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Resource">
                        <MudLink Href="@($"/resource/{context.ResourceId}")">@(context.Resource?.Name ?? context.ResourceId.ToString())</MudLink>
                    </MudTd>
                    <MudTd DataLabel="Type">
                        <MudText Typo="Typo.body2">@(context.Resource?.Type?.Name ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="RefId">
                        <MudText Typo="Typo.caption" Class="mono">@(context.Resource?.RefId ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="PolicyPath">
                        <MudText Typo="Typo.caption" Class="mono">@(context.PolicyPath ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="PolicyVersion">
                        <MudText Typo="Typo.body2">@(context.PolicyVersion ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="DelegationChangeId">
                        <MudText Typo="Typo.body2">@context.DelegationChangeId</MudText>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">No direct resources on this assignment.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@($"Packages ({_data.Packages.Count})")"
                     Icon="@Icons.Material.Filled.Inventory2">
            <MudTable Items="_data.Packages" Hover="true" Dense="true" Class="pa-0">
                <HeaderContent>
                    <MudTh>Package</MudTh>
                    <MudTh>URN</MudTh>
                    <MudTh>Area</MudTh>
                    <MudTh>Provider</MudTh>
                    <MudTh>Since</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Package">
                        <MudLink Href="@($"/package/{context.PackageId}")">
                            @(context.Package?.Name ?? context.PackageId.ToString())
                        </MudLink>
                    </MudTd>
                    <MudTd DataLabel="URN">
                        <MudText Typo="Typo.caption" Class="mono">@(context.Package?.Urn ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Area">
                        <MudText Typo="Typo.body2">@(context.Package?.Area?.Name ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Provider">
                        <MudText Typo="Typo.body2">@(context.Package?.Provider?.Name ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Since">
                        <MudText Typo="Typo.body2">@context.Audit_ValidFrom.ToString("yyyy-MM-dd")</MudText>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">No direct packages on this assignment.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@($"Instances ({_data.Instances.Count})")"
                     Icon="@Icons.Material.Filled.DataObject">
            <MudTable Items="_data.Instances" Hover="true" Dense="true" Class="pa-0">
                <HeaderContent>
                    <MudTh>Resource</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>InstanceId</MudTh>
                    <MudTh>InstanceSourceType</MudTh>
                    <MudTh>PolicyPath</MudTh>
                    <MudTh>PolicyVersion</MudTh>
                    <MudTh>DelegationChangeId</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Resource">
                        <MudText Typo="Typo.body2">@context.Resource?.Name</MudText>
                    </MudTd>
                    <MudTd DataLabel="Type">
                        <MudText Typo="Typo.body2">@(context.Resource?.Type?.Name ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="InstanceId">
                        <MudText Typo="Typo.caption" Class="mono">@context.InstanceId</MudText>
                    </MudTd>
                    <MudTd DataLabel="InstanceSourceType">
                        <MudText Typo="Typo.body2">@(context.InstanceSourceType?.Name ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="PolicyPath">
                        <MudText Typo="Typo.caption" Class="mono">@(context.PolicyPath ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="PolicyVersion">
                        <MudText Typo="Typo.body2">@(context.PolicyVersion ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="DelegationChangeId">
                        <MudText Typo="Typo.body2">@context.DelegationChangeId</MudText>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">No instances on this assignment.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

    </MudTabs>

    @* ── Automatic: derived from the role via RoleResource and RolePackage ── *@
    <MudText Typo="Typo.h5" Class="mt-8 mb-1">Automatic</MudText>
    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
        Resources and packages automatically granted through role
        <MudLink Href="@($"/role/{_data.Assignment.RoleId}")">@(_data.Assignment.Role?.Name ?? _data.Assignment.RoleId.ToString())</MudLink>.
    </MudText>
    <MudTabs Elevation="1" Rounded="false" ApplyEffectsToContainer="true">

        <MudTabPanel Text="@($"Resources ({_data.AutoResources.Count})")"
                     Icon="@Icons.Material.Filled.Api">
            <MudTable Items="_data.AutoResources" Hover="true" Dense="true" Class="pa-0">
                <HeaderContent>
                    <MudTh>Resource</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>RefId</MudTh>
                    <MudTh>Provider</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Resource">
                        <MudLink Href="@($"/resource/{context.ResourceId}")">@(context.Resource?.Name ?? context.ResourceId.ToString())</MudLink>
                    </MudTd>
                    <MudTd DataLabel="Type">
                        <MudText Typo="Typo.body2">@(context.Resource?.Type?.Name ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="RefId">
                        <MudText Typo="Typo.caption" Class="mono">@(context.Resource?.RefId ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Provider">
                        <MudLink Href="@($"/provider/{context.Resource?.ProviderId}")">@(context.Resource?.Provider?.Name ?? "–")</MudLink>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">No automatic resources via this role.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@($"Packages ({_data.AutoPackages.Count})")"
                     Icon="@Icons.Material.Filled.Inventory2">
            <MudTable Items="_data.AutoPackages" Hover="true" Dense="true" Class="pa-0">
                <HeaderContent>
                    <MudTh>Package</MudTh>
                    <MudTh>URN</MudTh>
                    <MudTh>EntityVariant</MudTh>
                    <MudTh>HasAccess</MudTh>
                    <MudTh>CanAssign</MudTh>
                    <MudTh>CanDelegate</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Package">
                        <MudLink Href="@($"/package/{context.PackageId}")">
                            @(context.Package?.Name ?? context.PackageId.ToString())
                        </MudLink>
                    </MudTd>
                    <MudTd DataLabel="URN">
                        <MudText Typo="Typo.caption" Class="mono">@(context.Package?.Urn ?? "–")</MudText>
                    </MudTd>
                    <MudTd DataLabel="EntityVariant">
                        @if (context.EntityVariantId.HasValue)
                        {
                            <MudLink Href="@($"/entity-variant/{context.EntityVariantId}")">
                                @(context.EntityVariant?.Name ?? context.EntityVariantId.ToString())
                            </MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">All</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="HasAccess">
                        <MudIcon Icon="@(context.HasAccess ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                 Color="@(context.HasAccess ? Color.Success : Color.Error)"
                                 Size="Size.Small" />
                    </MudTd>
                    <MudTd DataLabel="CanAssign">
                        <MudIcon Icon="@(context.CanAssign ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                 Color="@(context.CanAssign ? Color.Success : Color.Error)"
                                 Size="Size.Small" />
                    </MudTd>
                    <MudTd DataLabel="CanDelegate">
                        <MudIcon Icon="@(context.CanDelegate ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                 Color="@(context.CanDelegate ? Color.Success : Color.Error)"
                                 Size="Size.Small" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">No automatic packages via this role.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

    </MudTabs>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private AssignmentDetailsData? _data;

    protected override Task OnParametersSetAsync() => RunAsync(LoadAsync);

    protected override Task OnEnvironmentChangedAsync() => RunAsync(LoadAsync);

    private async Task LoadAsync(CancellationToken ct) => _data = await DataService.GetAsync(EnvState.Current, Id, ct);
}
