@page "/entity-search"
@inherits EnvironmentPageBase
@inject EntitySearchService SearchService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Entity-søk – Access Management</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Entity-søk</MudText>
<MudText Typo="Typo.body1" Class="mb-6 mud-text-secondary">
    Søk opp entities direkte mot databasen via <code>DbSet&lt;Entity&gt;</code>.
    Søketermen tolkes som UUID, organisasjonsnummer, fødselsnummer, party-id eller navn
    og slås opp mot riktig felt.
</MudText>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="_searchTerm"
                          Label="Søk"
                          Variant="Variant.Outlined"
                          Placeholder="Navn, UUID, org.nr, fødselsnr, party-id..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="OnKeyDown"
                          Immediate="false" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudSelect T="EntitySearchKind?"
                       @bind-Value="_selectedKind"
                       Label="Søk etter"
                       Variant="Variant.Outlined"
                       Dense="true"
                       ToStringFunc="@KindDisplay">
                <MudSelectItem T="EntitySearchKind?" Value="@((EntitySearchKind?)null)">Auto</MudSelectItem>
                @foreach (var kind in Enum.GetValues<EntitySearchKind>())
                {
                    <MudSelectItem T="EntitySearchKind?" Value="@((EntitySearchKind?)kind)">
                        @KindDisplay(kind)
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="2">
            <MudCheckBox @bind-Value="_includeDeleted" Label="Vis slettede" Color="Color.Primary" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="Search"
                       FullWidth="true">
                Søk
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (Loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}

@if (Error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@Error</MudAlert>
}

@if (_results is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @if (_results.Count == EntitySearchService.MaxResults)
            {
                <span>Viser de første @EntitySearchService.MaxResults treffene – prøv et mer spesifikt søk</span>
            }
            else
            {
                <span>@_results.Count treff</span>
            }
        </MudText>
        @if (_usedKind is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                Søkte på @EntitySearchKindText.Label(_usedKind.Value)
            </MudChip>
        }
    </MudStack>

    <MudPaper Elevation="1">
        <MudTable Items="_results" Hover="true" Dense="true" FixedHeader="true" Height="600px">
            <HeaderContent>
                <MudTh>Navn</MudTh>
                <MudTh>UUID</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Variant</MudTh>
                <MudTh>OrgNr</MudTh>
                <MudTh>Fødselsnr</MudTh>
                <MudTh>Party ID</MudTh>
                <MudTh>Brukernavn</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Navn">
                    <MudLink Href="@($"/entity/{context.Id}")" Typo="Typo.body2">@context.Name</MudLink>
                </MudTd>
                <MudTd DataLabel="UUID">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTooltip Text="@context.Id.ToString()">
                            <MudText Typo="Typo.body2" Style="font-family:monospace">@ShortId(context.Id)</MudText>
                        </MudTooltip>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                       Size="Size.Small"
                                       aria-label="Kopier UUID"
                                       OnClick="@(() => CopyId(context.Id))" />
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Type">
                    <MudText Typo="Typo.body2">@(context.Type?.Name ?? "–")</MudText>
                </MudTd>
                <MudTd DataLabel="Variant">
                    <MudText Typo="Typo.body2">@(context.Variant?.Name ?? "–")</MudText>
                </MudTd>
                <MudTd DataLabel="OrgNr">
                    <MudText Typo="Typo.body2">@(context.OrganizationIdentifier ?? "–")</MudText>
                </MudTd>
                <MudTd DataLabel="Fødselsnr">
                    <MudText Typo="Typo.body2">@MaskPersonIdentifier(context.PersonIdentifier)</MudText>
                </MudTd>
                <MudTd DataLabel="Party ID">
                    <MudText Typo="Typo.body2">@(context.PartyId?.ToString() ?? "–")</MudText>
                </MudTd>
                <MudTd DataLabel="Brukernavn">
                    <MudText Typo="Typo.body2">@(context.Username ?? "–")</MudText>
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (context.IsDeleted)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">Slettet</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Aktiv</MudChip>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4 mud-text-secondary">Ingen treff – prøv et annet søkeord eller en annen søketype.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private string _searchTerm = string.Empty;
    private bool _includeDeleted;
    private EntitySearchKind? _selectedKind;
    private EntitySearchKind? _usedKind;
    private List<Entity>? _results;

    protected override Task OnEnvironmentChangedAsync()
    {
        // Results belong to the previous environment.
        _results = null;
        _usedKind = null;
        Error = null;
        return Task.CompletedTask;
    }

    private async Task Search()
    {
        _results = null;
        _usedKind = null;

        var term = _searchTerm.Trim();
        if (term.Length < 2)
        {
            Error = "Skriv minst 2 tegn for å søke.";
            return;
        }

        var kind = _selectedKind ?? EntitySearchService.DetectKind(term);
        await RunAsync(async ct =>
        {
            _results = await SearchService.SearchAsync(EnvState.Current, term, _includeDeleted, kind, ct: ct);
            _usedKind = kind;
        });
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task CopyId(Guid id)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", id.ToString());
        Snackbar.Add("UUID kopiert", Severity.Success);
    }

    private static string ShortId(Guid id) => id.ToString()[..8] + "…";

    private static string KindDisplay(EntitySearchKind? kind) =>
        kind is null ? "Auto" : Capitalize(EntitySearchKindText.Label(kind.Value));

    private static string Capitalize(string text) =>
        text.Length > 0 ? char.ToUpperInvariant(text[0]) + text[1..] : text;

    private static string MaskPersonIdentifier(string? fnr) =>
        fnr?.Length == 11 ? fnr[..6] + "*****" : fnr ?? "–";
}
